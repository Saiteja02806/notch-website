---
import { limits } from '@/data/content'
---

<section class="section" aria-labelledby="limits-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span> Honest limits</span>
      <h2 class="h2" id="limits-title">What it does not do.</h2>
      <p class="lede">
        Every desktop utility has trade-offs. Here are ours upfront — before you download, not after.
      </p>
    </div>

    <ul class="limits">
      {
        limits.map((limit) => (
          <li>
            <span>
              <strong>{limit.title}</strong> {limit.body}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
