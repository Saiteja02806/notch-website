<script>
  const workbench = document.querySelector<HTMLElement>('[data-notes-workbench]')
  if (workbench) {
    const treeEl = workbench.querySelector<HTMLElement>('[data-notes-tree]')
    const renderedEl = workbench.querySelector<HTMLElement>('[data-notes-rendered]')
    const textareaEl = workbench.querySelector<HTMLTextAreaElement>('[data-notes-textarea]')
    const modeButtons = Array.from(workbench.querySelectorAll<HTMLButtonElement>('[data-note-mode]'))
    const filenameEl = workbench.querySelector<HTMLElement>('[data-note-filename]')
    const filenameMirrorEl = workbench.querySelector<HTMLElement>('[data-note-filename-mirror]')
    const wordsEl = workbench.querySelector<HTMLElement>('[data-note-words]')
    const vaultCountEl = workbench.querySelector<HTMLElement>('[data-vault-count]')
    const saveStatusEl = workbench.querySelector<HTMLElement>('[data-note-save-status]')
    const summaryEl = workbench.querySelector<HTMLElement>('[data-note-task-summary]')
    const searchInput = workbench.querySelector<HTMLInputElement>('[data-notes-search]')
    const exportBtn = workbench.querySelector<HTMLButtonElement>('[data-download-md]')
    const newNoteBtns = Array.from(workbench.querySelectorAll<HTMLButtonElement>('[data-new-note-btn]'))
    const fmtBtns = Array.from(workbench.querySelectorAll<HTMLButtonElement>('[data-fmt]'))
    const obsidianBtn = workbench.querySelector<HTMLButtonElement>('[data-open-obsidian]')
    const toastEl = workbench.querySelector<HTMLElement>('[data-obsidian-toast]')

    const vaultNotes: Record<string, { meta: string; content: string }> = {
      'roadmap.md': {
        meta: 'macOS + Win',
        content: [
          '# Hero Notch 1.0 — Local Markdown Workspace',
          '> Plain **.md files** on disk for MacBook & Windows. Zero cloud lock-in, instant access from the top edge.',
          '## Release Checklist',
          '- [x] Mount existing **Obsidian vault** with `750ms` debounced auto-save',
          '- [x] Render inline `# headings`, `**bold**`, `_italic_`, `code` and [[obsidian-workflow.md]]',
          '- [x] Stream live turns in [[ai-sessions.md]] & agenda in [[daily-2026-11-17.md]]',
          '- [ ] Test drag-and-drop folder organization & click _Open in Obsidian_'
        ].join('\n')
      },
      'obsidian-workflow.md': {
        meta: 'vault · links',
        content: [
          '# Obsidian Vault & Local Folder Workflow',
          '> Point Hero Notch at `~/Obsidian/HeroNotchVault` — `.obsidian`, `.trash` and `.git` are ignored automatically.',
          '## How Bi-Directional Editing Works',
          '- [x] Edits write straight back to plain UTF-8 `.md` files in `750ms`',
          '- [x] Click any wiki-link like [[roadmap.md]] or [[ai-sessions.md]] to jump notes',
          '- [x] Press `Cmd/Ctrl+K` for instant filename and full-text vault search',
          '- [ ] Launch current note in desktop Obsidian via `obsidian://open`'
        ].join('\n')
      },
      'ai-sessions.md': {
        meta: '4 agents',
        content: [
          '# AI Coding Sessions Architecture',
          '> Monitor **Claude Code**, **Codex**, **OpenCode** and **Anti Gravity** side by side from local session logs.',
          '## Verified Follow-up Flow',
          '- [x] Stream live turns, token totals and active model per project folder',
          '- [x] Confirm reply delivery against local session store (`Delivered` badge)',
          '- [x] Surface `OpenCode` tool-approval alerts at the top of your display',
          '- [x] Link agent notes directly to [[roadmap.md]] and [[daily-2026-11-17.md]]'
        ].join('\n')
      },
      'daily-2026-11-17.md': {
        meta: 'gcal · timer',
        content: [
          '# Daily Plan — 2026-11-17',
          '> Synced with **Google Calendar** agenda strip + 12-second under-notch reminder cards.',
          '## Today’s Schedule & Focus Blocks',
          '- [x] 10:00 — Review `NotesPage.tsx` inline Markdown parser & [[obsidian-workflow.md]]',
          '- [x] 13:00 — Beam build screenshots to phone via `Phone QR` local Wi-Fi',
          '- [ ] 15:00 — Check [[ai-sessions.md]] for Claude Code & Codex verification',
          '- [ ] 16:30 — Run 25-minute breathing focus timer with desktop blur backdrop'
        ].join('\n')
      }
    }

    let activeNote = 'roadmap.md'
    let saveTimer: number | undefined
    let createdCounter = 1

    const escapeHtml = (str: string): string =>
      str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')

    const formatInline = (raw: string): string => {
      const codeSpans: string[] = []
      let s = escapeHtml(raw)
      // Stash `code` first so bold/italic markers inside code examples are preserved literally
      s = s.replace(/`([^`]+)`/g, (_m, code: string) => {
        const idx = codeSpans.push(`<code>${code}</code>`) - 1
        return `\u0000CODE${idx}\u0000`
      })
      // [[wiki-links]]
      s = s.replace(/\[\[([^\]]+)\]\]/g, (_m, target: string) => {
        const clean = target.trim()
        const fileTarget = clean.endsWith('.md') ? clean : `${clean}.md`
        return `<button type="button" class="wiki-link" data-wiki-target="${fileTarget}">${clean}</button>`
      })
      // **bold**
      s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      // _italic_
      s = s.replace(/(^|\s)_([^_]+)_/g, '$1<em>$2</em>')
      // Restore stashed code spans
      return s.replace(/\u0000CODE(\d+)\u0000/g, (_m, idx: string) => codeSpans[Number(idx)] ?? '')
    }

    const flashSaved = (): void => {
      if (!saveStatusEl) return
      saveStatusEl.textContent = 'Saving to disk…'
      if (saveTimer) window.clearTimeout(saveTimer)
      saveTimer = window.setTimeout(() => {
        saveStatusEl.textContent = '✓ Saved in 750ms to disk'
      }, 380)
    }

    const showToast = (msg: string): void => {
      if (!toastEl) return
      toastEl.textContent = msg
      toastEl.hidden = false
      window.setTimeout(() => {
        toastEl.hidden = true
      }, 2400)
    }

    const renderActiveNote = (syncTextarea = true): void => {
      const note = vaultNotes[activeNote]
      if (!note || !renderedEl) return
      if (syncTextarea && textareaEl && textareaEl.value !== note.content) {
        textareaEl.value = note.content
      }
      if (filenameEl) filenameEl.textContent = activeNote
      if (filenameMirrorEl) filenameMirrorEl.textContent = activeNote

      const words = note.content.trim() ? note.content.trim().split(/\s+/).length : 0
      if (wordsEl) wordsEl.textContent = `${words} words`
      if (vaultCountEl) vaultCountEl.textContent = `${Object.keys(vaultNotes).length} .md`

      const lines = note.content.split('\n')
      let totalTasks = 0
      let completedTasks = 0

      const html = lines
        .map((line, lineIdx) => {
          const h1 = /^#\s+(.*)$/.exec(line)
          if (h1) {
            return `<div class="notes-line notes-line-h1">${formatInline(h1[1])}</div>`
          }
          const h2 = /^##+\s+(.*)$/.exec(line)
          if (h2) {
            return `<div class="notes-line notes-line-h2">${formatInline(h2[1])}</div>`
          }
          const quote = /^>\s?(.*)$/.exec(line)
          if (quote) {
            return `<div class="notes-line notes-line-quote">${formatInline(quote[1])}</div>`
          }
          const task = /^(\s*[-*+]\s+\[)([ xX])(\]\s+)(.*)$/.exec(line)
          if (task) {
            totalTasks += 1
            const isChecked = task[2].toLowerCase() === 'x'
            if (isChecked) completedTasks += 1
            return `<label class="notes-check${isChecked ? ' is-checked' : ''}">
              <input type="checkbox" ${isChecked ? 'checked' : ''} data-line-index="${lineIdx}" />
              <span class="notes-check-box" aria-hidden="true"></span>
              <span class="notes-check-text">${formatInline(task[4])}</span>
            </label>`
          }
          if (!line.trim()) return ''
          return `<div class="notes-line notes-line-p">${formatInline(line)}</div>`
        })
        .join('')

      renderedEl.innerHTML = html
      if (summaryEl) {
        summaryEl.textContent =
          totalTasks > 0 ? `${completedTasks} / ${totalTasks} tasks completed` : `${lines.length} lines · UTF-8`
      }
    }

    const selectNote = (name: string): void => {
      if (!vaultNotes[name]) return
      activeNote = name
      if (treeEl) {
        Array.from(treeEl.querySelectorAll<HTMLButtonElement>('[data-note-select]')).forEach((btn) => {
          const isCurrent = btn.dataset.noteSelect === name
          btn.classList.toggle('is-active', isCurrent)
          btn.setAttribute('aria-selected', String(isCurrent))
        })
      }
      renderActiveNote(true)
    }

    treeEl?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-note-select]')
      if (!btn) return
      selectNote(btn.dataset.noteSelect ?? 'roadmap.md')
    })

    renderedEl?.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement
      if (input.tagName !== 'INPUT' || input.dataset.lineIndex === undefined) return
      const idx = Number(input.dataset.lineIndex)
      const lines = vaultNotes[activeNote].content.split('\n')
      if (lines[idx] !== undefined) {
        lines[idx] = lines[idx].replace(/^(\s*[-*+]\s+\[)[ xX](\]\s+)/, `$1${input.checked ? 'x' : ' '}$2`)
        vaultNotes[activeNote].content = lines.join('\n')
        renderActiveNote(true)
        flashSaved()
      }
    })

    renderedEl?.addEventListener('click', (e) => {
      const wiki = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-wiki-target]')
      if (!wiki) return
      e.preventDefault()
      const target = wiki.dataset.wikiTarget ?? ''
      if (vaultNotes[target]) {
        selectNote(target)
        showToast(`Jumped to [[${target}]]`)
      }
    })

    textareaEl?.addEventListener('input', () => {
      vaultNotes[activeNote].content = textareaEl.value
      renderActiveNote(false)
      flashSaved()
    })

    const applyToolbarFormat = (kind: string): void => {
      if (!textareaEl) return
      const start = textareaEl.selectionStart ?? textareaEl.value.length
      const end = textareaEl.selectionEnd ?? textareaEl.value.length
      const selected = textareaEl.value.slice(start, end)
      let replacement = ''
      if (kind === 'bold') replacement = `**${selected || 'bold text'}**`
      else if (kind === 'italic') replacement = `_${selected || 'italic text'}_`
      else if (kind === 'heading') replacement = `\n## ${selected || 'New Section'}`
      else if (kind === 'task') replacement = `\n- [ ] ${selected || 'New checklist item'}`
      else if (kind === 'code') replacement = `\`${selected || 'code'}\``
      else if (kind === 'wikilink') replacement = `[[${selected || 'ai-sessions.md'}]]`

      textareaEl.setRangeText(replacement, start, end, 'end')
      textareaEl.focus()
      vaultNotes[activeNote].content = textareaEl.value
      renderActiveNote(false)
      flashSaved()
    }

    fmtBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyToolbarFormat(btn.dataset.fmt ?? 'bold')
      })
    })

    newNoteBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filename = `note-${createdCounter++}.md`
        vaultNotes[filename] = {
          meta: 'just now',
          content: [
            `# Untitled Note ${createdCounter - 1}`,
            '> Created in `~/Obsidian/HeroNotchVault` — edits auto-save in 750ms.',
            '## Quick Thoughts',
            '- [ ] Link back to [[roadmap.md]] or [[obsidian-workflow.md]]',
            '- [ ] Type below or toggle tasks right inside the notch'
          ].join('\n')
        }
        if (treeEl) {
          const item = document.createElement('button')
          item.type = 'button'
          item.className = 'notes-file'
          item.dataset.noteSelect = filename
          item.setAttribute('role', 'option')
          item.setAttribute('aria-selected', 'false')
          item.innerHTML = `<span class="notes-file-name">${filename}</span><span class="notes-file-meta">just now</span>`
          treeEl.appendChild(item)
        }
        workbench.dataset.previewMode = 'false'
        modeButtons.forEach((b) => b.classList.toggle('is-active', b.dataset.noteMode === 'inline'))
        selectNote(filename)
        textareaEl?.focus()
        flashSaved()
        showToast(`Created ${filename} in ~/Obsidian/HeroNotchVault`)
      })
    })

    obsidianBtn?.addEventListener('click', () => {
      showToast(`obsidian://open?vault=HeroNotchVault&file=${encodeURIComponent(activeNote)}`)
    })

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.noteMode ?? 'inline'
        workbench.dataset.previewMode = String(mode === 'preview')
        modeButtons.forEach((b) => b.classList.toggle('is-active', b === btn))
      })
    })

    searchInput?.addEventListener('input', () => {
      const q = searchInput.value.trim().toLowerCase()
      if (!treeEl) return
      Array.from(treeEl.querySelectorAll<HTMLButtonElement>('[data-note-select]')).forEach((btn) => {
        const file = btn.dataset.noteSelect ?? ''
        const body = vaultNotes[file]?.content.toLowerCase() ?? ''
        const match = !q || file.toLowerCase().includes(q) || body.includes(q)
        btn.style.display = match ? '' : 'none'
      })
    })

    exportBtn?.addEventListener('click', () => {
      const raw = vaultNotes[activeNote]?.content ?? ''
      const blob = new Blob([raw + '\n'], { type: 'text/markdown;charset=utf-8' })
      const url = URL.createObjectURL(blob)
      const a = document.createElement('a')
      a.href = url
      a.download = activeNote
      document.body.appendChild(a)
      a.click()
      a.remove()
      URL.revokeObjectURL(url)
    })

    renderActiveNote(true)
  }
</script>
