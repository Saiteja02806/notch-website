---
import { ArrowRight, FileText, FolderOpen, Search, Check, Plus } from '@lucide/astro'
---

<section class="section" id="features">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span> Features · Notes-First</span>
      <h2 class="h2">Built around your local Markdown vault.</h2>
      <p class="lede">
        Hero Notch starts with your plain <code>.md</code> files on disk — then surrounds them with your live
        AI coding sessions, Google Calendar day plan, macOS &amp; Windows media, and local Wi-Fi phone transfer.
      </p>
    </div>

    {/* Interactive "Inside the Notes Editor" showcase */}
    <div class="notes-showcase" data-notes-workbench data-preview-mode="false">
      <div class="notes-showcase-head">
        <div>
          <span class="notes-kicker">Inside the Notes Editor · Obsidian-Ready Local Workspace</span>
          <h3>Try the live Markdown engine before you buy.</h3>
          <p>
            Point Hero Notch at any folder or Obsidian vault (<code>.obsidian</code>, <code>.trash</code> and
            <code>.git</code> are ignored automatically). Toggle tasks, click <code>[[wiki-links]]</code> to jump
            between notes, type in the live Markdown editor, or create a new <code>.md</code> note on the spot.
          </p>
        </div>
        <div class="notes-showcase-actions">
          <button class="btn btn--ghost btn--sm" type="button" data-new-note-btn>
            <Plus size={14} /> New .md Note
          </button>
          <button class="btn btn--ghost btn--sm" type="button" data-download-md>
            <FileText size={14} /> Export .md note
          </button>
          <a class="btn btn--ink btn--sm" href="/pricing">
            Unlock Full App · $3.99 <ArrowRight size={14} />
          </a>
        </div>
      </div>

      {/* Top Notch Frame with MacBook & Windows Header */}
      <div class="notch-shell">
        <div class="notch-bezel">
          <div class="notch-bezel-left">
            <span class="os-pill is-active" data-os-pill="mac">
              <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
                <path d="M11.182 8.51c-.015-1.57 1.283-2.327 1.341-2.363-.73-1.068-1.867-1.214-2.271-1.231-.967-.098-1.887.569-2.378.569-.49 0-1.248-.555-2.05-.54-1.055.015-2.027.613-2.57 1.556-1.096 1.9-.28 4.715.788 6.257.522.755 1.144 1.604 1.96 1.574.787-.031 1.084-.509 2.035-.509.951 0 1.218.509 2.05.493.847-.015 1.383-.77 1.903-1.525.6-.876.847-1.724.862-1.769-.019-.008-1.655-.635-1.67-2.512zm-1.564-4.62c.433-.525.725-1.254.645-1.98-.624.025-1.379.416-1.827.94-.401.464-.752 1.207-.658 1.92.697.054 1.407-.355 1.84-.88z" />
              </svg>
              <span>MacBook Pro · macOS</span>
            </span>
            <span class="os-pill" data-os-pill="win">
              <svg viewBox="0 0 16 16" width="9" height="9" fill="currentColor" aria-hidden="true">
                <path d="M1.5 1.5h5.8v5.8H1.5V1.5zm7.2 0h5.8v5.8H8.7V1.5zM1.5 8.7h5.8v5.8H1.5V8.7zm7.2 0h5.8v5.8H8.7V8.7z" />
              </svg>
              <span>Windows 11</span>
            </span>
          </div>
          <div class="notch-cutout" aria-hidden="true">
            <span class="notch-camera"></span>
            <span class="notch-label">Hero Notch · Notes</span>
            <span class="notch-live-dot"></span>
          </div>
          <div class="notch-bezel-right">
            <span class="shortcut-hint"><kbd>⌘</kbd>/<kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>N</kbd></span>
          </div>
        </div>

        {/* Hero Notch App Top Bar */}
        <div class="notch-appbar">
          <div class="notch-appbar-tabs" aria-label="Hero Notch surfaces">
            <span class="notch-brand-badge">
              <span class="notch-brand-dot"></span>
              Hero Notch
            </span>
            <span class="notch-surface-tab is-active">Notes</span>
            <a class="notch-surface-tab" href="#details">Sessions</a>
            <a class="notch-surface-tab" href="#details">Plan</a>
            <a class="notch-surface-tab" href="#details">Music</a>
            <a class="notch-surface-tab" href="#details">Posture</a>
          </div>

          <div class="notch-appbar-meta">
            <span class="notes-autosave" data-note-save-status>
              <Check size={11} /> Saved in 750ms to disk
            </span>
            <button
              type="button"
              class="notes-obsidian-btn"
              data-open-obsidian
              title="Opens obsidian://open?vault=HeroNotchVault in the desktop app"
            >
              Open in Obsidian ↗
            </button>
          </div>
        </div>

        <div class="notes-window">
          <aside class="notes-sidebar" aria-label="Sample Obsidian vault tree">
            <div class="notes-vault-bar">
              <FolderOpen size={13} />
              <span class="notes-vault-name" title="~/Obsidian/HeroNotchVault">~/Obsidian/HeroNotchVault</span>
              <span class="notes-vault-count" data-vault-count>4 .md</span>
            </div>

            <label class="notes-search">
              <Search size={12} />
              <input
                type="search"
                placeholder="Search (⌘K / Ctrl+K)…"
                aria-label="Filter sample vault notes"
                data-notes-search
              />
              <kbd>⌘K</kbd>
            </label>

            <div class="notes-tree-bar">
              <span>VAULT FILES</span>
              <button type="button" class="tree-new-link" data-new-note-btn>+ New Note</button>
            </div>

            <div class="notes-tree" role="listbox" aria-label="Markdown files" data-notes-tree>
              <button
                type="button"
                class="notes-file is-active"
                data-note-select="roadmap.md"
                role="option"
                aria-selected="true"
              >
                <span class="notes-file-name">roadmap.md</span>
                <span class="notes-file-meta">macOS + Win</span>
              </button>
              <button
                type="button"
                class="notes-file"
                data-note-select="obsidian-workflow.md"
                role="option"
                aria-selected="false"
              >
                <span class="notes-file-name">obsidian-workflow.md</span>
                <span class="notes-file-meta">vault · links</span>
              </button>
              <button
                type="button"
                class="notes-file"
                data-note-select="ai-sessions.md"
                role="option"
                aria-selected="false"
              >
                <span class="notes-file-name">ai-sessions.md</span>
                <span class="notes-file-meta">4 agents</span>
              </button>
              <button
                type="button"
                class="notes-file"
                data-note-select="daily-2026-11-17.md"
                role="option"
                aria-selected="false"
              >
                <span class="notes-file-name">daily-2026-11-17.md</span>
                <span class="notes-file-meta">gcal · timer</span>
              </button>
            </div>

            <div class="notes-ignored">
              <span>Ignored automatically:</span>
              <code>.obsidian/</code> <code>.trash/</code> <code>.git/</code>
            </div>
          </aside>

          <div class="notes-main">
            {/* Breadcrumb & Mode Bar */}
            <div class="notes-toolbar">
              <div class="notes-path">
                <span class="notes-breadcrumb">HeroNotchVault /</span>
                <strong data-note-filename>roadmap.md</strong>
                <span class="notes-wordcount" data-note-words>64 words</span>
              </div>

              <div class="notes-mode-group" role="group" aria-label="Editor mode">
                <button type="button" class="notes-mode-btn is-active" data-note-mode="inline">
                  Inline Edit
                </button>
                <button type="button" class="notes-mode-btn" data-note-mode="preview">
                  Preview
                </button>
              </div>
            </div>

            {/* Formatting Toolbar (Just Like NotesPage.tsx) */}
            <div class="notes-fmt-bar" role="toolbar" aria-label="Markdown formatting toolbar">
              <div class="fmt-group">
                <button type="button" class="fmt-btn" data-fmt="bold" title="Bold (Cmd/Ctrl+B)">
                  <strong>B</strong>
                </button>
                <button type="button" class="fmt-btn" data-fmt="italic" title="Italic (Cmd/Ctrl+I)">
                  <em>I</em>
                </button>
                <button type="button" class="fmt-btn" data-fmt="heading" title="Heading (#)">
                  # H2
                </button>
              </div>
              <span class="fmt-sep" aria-hidden="true"></span>
              <div class="fmt-group">
                <button type="button" class="fmt-btn" data-fmt="task" title="Insert Checklist (- [ ])">
                  ☑ Task
                </button>
                <button type="button" class="fmt-btn" data-fmt="code" title="Inline Code (`)">
                  <code>&lt;/&gt;</code> Code
                </button>
                <button type="button" class="fmt-btn" data-fmt="wikilink" title="Insert Obsidian Wiki-Link ([[]])">
                  [[Wiki Link]]
                </button>
              </div>
              <span class="fmt-sep" aria-hidden="true"></span>
              <button type="button" class="fmt-btn fmt-btn--new" data-new-note-btn title="Create a new .md file in the vault">
                + New Note
              </button>
              <span class="fmt-toast" data-obsidian-toast hidden></span>
            </div>

            {/* Dual Interactive Body: Rendered Live Inline Document + Editable Raw Markdown Scratchpad */}
            <div class="notes-workspace-split">
              <div class="notes-doc" data-notes-rendered aria-live="polite">
                {/* Populated and kept in sync by the live Markdown engine below */}
              </div>

              <div class="notes-live-input-wrap" data-live-editor-pane>
                <div class="notes-live-input-head">
                  <span>LIVE MARKDOWN SOURCE (<code data-note-filename-mirror>roadmap.md</code>)</span>
                  <span class="live-hint">Type Markdown or use toolbar buttons — renders above in real time</span>
                </div>
                <textarea
                  class="notes-textarea"
                  data-notes-textarea
                  rows="7"
                  spellcheck="false"
                  aria-label="Live Markdown source editor"
                ></textarea>
              </div>
            </div>

            <div class="notes-statusbar">
              <span>UTF-8 · Plain Markdown (<code>.md</code>) on disk</span>
              <span data-note-task-summary>3 / 4 tasks completed</span>
              <span>Click any <code>[[wiki-link]]</code> to jump notes · ⌘K / Ctrl+K Search</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .notes-showcase {
    margin-bottom: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-stage);
    background: var(--paper-2);
    padding: clamp(22px, 3.2vw, 38px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .notes-showcase-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .notes-kicker {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .notes-showcase-head h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(26px, 3vw, 38px);
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .notes-showcase-head p {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--muted);
    max-width: 66ch;
  }

  .notes-showcase-head code,
  .section-head code {
    font-family: var(--mono);
    font-size: 12px;
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--ink);
  }

  .notes-showcase-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* Top Notch Shell */
  .notch-shell {
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #050507;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.1) inset,
      0 36px 80px -34px rgba(0, 0, 0, 0.85);
  }

  .notch-bezel {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 16px;
    height: 38px;
    background: #020203;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.55);
  }

  .notch-bezel-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .os-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.5);
    font-size: 9.5px;
    white-space: nowrap;
  }

  .os-pill.is-active {
    border-color: rgba(255, 255, 255, 0.32);
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .notch-cutout {
    height: 30px;
    align-self: start;
    padding: 0 18px;
    border-radius: 0 0 14px 14px;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-top: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: 10px;
    letter-spacing: 0.06em;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.8);
  }

  .notch-camera {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: radial-gradient(circle, #27272a 30%, #09090b 75%);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .notch-live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 8px #ffffff;
  }

  .notch-bezel-right {
    display: flex;
    justify-content: flex-end;
  }

  .shortcut-hint kbd {
    font-family: var(--mono);
    font-size: 9.5px;
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.82);
  }

  .notch-appbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 18px;
    background: #09090c;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  .notch-appbar-tabs {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .notch-brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    color: #ffffff;
    padding-right: 10px;
    margin-right: 4px;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }

  .notch-brand-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
  }

  .notch-surface-tab {
    font-family: var(--mono);
    font-size: 10.5px;
    padding: 4px 10px;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.52);
    border: 1px solid transparent;
    transition: color 140ms ease, background 140ms ease;
  }

  .notch-surface-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  .notch-surface-tab.is-active {
    color: #050505;
    background: #ffffff;
    font-weight: 600;
  }

  .notch-appbar-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .notes-obsidian-btn {
    font-family: var(--mono);
    font-size: 10px;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 4px 11px;
    cursor: pointer;
    transition: background 140ms ease, border-color 140ms ease;
  }

  .notes-obsidian-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: #ffffff;
  }

  .notes-window {
    background: #070709;
    color: #f2f2f2;
    display: grid;
    grid-template-columns: 278px minmax(0, 1fr);
    overflow: hidden;
  }

  .notes-sidebar {
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    background: #0b0b0e;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .notes-vault-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.88);
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .notes-vault-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .notes-vault-count {
    margin-left: auto;
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.48);
  }

  .notes-search {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 9px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.55);
  }

  .notes-search input {
    width: 100%;
    border: 0;
    background: transparent;
    color: #ffffff;
    font-family: var(--mono);
    font-size: 11px;
    outline: none;
  }

  .notes-search input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .notes-search kbd {
    font-family: var(--mono);
    font-size: 9px;
    padding: 1px 4px;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.45);
  }

  .notes-tree-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.42);
  }

  .tree-new-link {
    border: 0;
    background: none;
    color: #ffffff;
    font-family: var(--mono);
    font-size: 10px;
    cursor: pointer;
    padding: 0;
  }

  .tree-new-link:hover {
    text-decoration: underline;
  }

  .notes-tree {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .notes-tree :global(.notes-file) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    font-family: var(--mono);
    font-size: 11.5px;
    text-align: left;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }

  .notes-tree :global(.notes-file:hover) {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }

  .notes-tree :global(.notes-file.is-active) {
    background: rgba(255, 255, 255, 0.11);
    border-color: rgba(255, 255, 255, 0.26);
    color: #ffffff;
  }

  .notes-tree :global(.notes-file-name) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .notes-tree :global(.notes-file-meta) {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.38);
  }

  .notes-ignored {
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.4);
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }

  .notes-ignored code {
    color: rgba(255, 255, 255, 0.68);
    background: rgba(255, 255, 255, 0.06);
    padding: 1px 4px;
    border-radius: 4px;
  }

  .notes-main {
    display: flex;
    flex-direction: column;
    min-height: 420px;
  }

  .notes-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    flex-wrap: wrap;
  }

  .notes-path {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: #ffffff;
  }

  .notes-breadcrumb {
    color: rgba(255, 255, 255, 0.42);
  }

  .notes-wordcount {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.45);
    padding-left: 6px;
  }

  .notes-autosave {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.78);
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.04);
  }

  .notes-mode-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .notes-mode-btn {
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: transparent;
    color: rgba(255, 255, 255, 0.62);
    border-radius: 999px;
    padding: 4px 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .notes-mode-btn.is-active {
    background: #ffffff;
    color: #090909;
    border-color: #ffffff;
    font-weight: 600;
  }

  /* Formatting Toolbar */
  .notes-fmt-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #0a0a0d;
    flex-wrap: wrap;
  }

  .fmt-group {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .fmt-sep {
    width: 1px;
    height: 16px;
    background: rgba(255, 255, 255, 0.1);
  }

  .fmt-btn {
