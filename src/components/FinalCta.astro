---
import { Download, GitBranch } from '@lucide/astro'
import { site } from '@/data/site'
import { pricing, formatPrice } from '@/data/pricing'
---

<section class="cta-band">
  <div class="wrap">
    <div class="cta-inner">
      <span class="eyebrow" style="color: rgba(242,240,233,.5)">Windows 10 and 11 · early bird {formatPrice(pricing.earlyBird.price)}</span>
      <h2>Put it at the top of your screen.</h2>
      <p>Local, one-time license, about a minute to install.</p>
      <div class="btns">
        <a class="btn btn--coral" href="/download"><Download size={15} /> Download for Windows</a>
        <a class="btn btn--night" href={site.repoUrl} rel="noopener"><GitBranch size={15} /> View on GitHub</a>
      </div>
    </div>
  </div>
</section>
