---
import { ArrowRight, Play } from '@lucide/astro'
import { pricing, formatPrice } from '@/data/pricing'

const earlyPrice = formatPrice(pricing.earlyBird.price)
const standardPrice = formatPrice(pricing.standard.price)
---

<section class="cta-band">
  <div class="wrap">
    <div class="cta-inner">
      <span class="eyebrow eyebrow--pill"><span class="dot"></span> Early Bird {earlyPrice} · Then {standardPrice} at launch</span>
      <h2>Put Hero Notch at the top of your screen.</h2>
      <p>
        Prebook your one-time Early Bird license ({earlyPrice} now, then {standardPrice} at launch)
        covering both MacBook and Windows — zero subscription, zero telemetry.
      </p>
      <div class="btns">
        <a class="btn btn--coral" href="/pricing">Prebook Early Bird — {earlyPrice} <ArrowRight size={15} /></a>
        <a class="btn btn--night" href="/#setup-video"><Play size={15} /> Watch Setup Video (51s)</a>
      </div>
    </div>
  </div>
</section>
