---
import { Download } from '@lucide/astro'
import { tour } from '@/data/content'
---

<section class="section tour" id="tour">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span> The tour</span>
      <h2 class="h2">Six surfaces, one hover away.</h2>
      <p class="lede">
        Start with local Markdown notes in your Obsidian vault, check on Claude Code and Codex
        sessions, review your Google Calendar plan, or control macOS &amp; Windows media — all from the top edge.
      </p>
    </div>

    <div class="tour-grid">
      <div class="tour-tabs" role="tablist" aria-label="Feature tour" aria-orientation="vertical">
        {
          tour.map((item, index) => (
            <button
              class="tour-tab"
              type="button"
              role="tab"
              id={`tour-tab-${item.id}`}
              aria-controls={`tour-panel-${item.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-tour-tab={item.id}
            >
              <span class="num">{String(index + 1).padStart(2, '0')}</span>
              <span class="name">{item.label}</span>
              {item.id === 'notes' && <span class="tour-pill">Lead</span>}
            </button>
          ))
        }
      </div>

      <div class="tour-stage">
        <div class="tour-chrome" aria-hidden="true">
          <span class="tour-chrome-title">Hero Notch · MacBook Pro (macOS) &amp; Windows 11</span>
          <span class="tour-chrome-hint">Monochrome Studio Capture · 1–6 keys</span>
        </div>
        {
          tour.map((item, index) => (
            <div
              class="tour-pane"
              role="tabpanel"
              id={`tour-panel-${item.id}`}
              aria-labelledby={`tour-tab-${item.id}`}
              hidden={index !== 0}
              data-tour-pane={item.id}
            >
              <div class="tour-media">
                <img
                  src={item.image}
                  alt={item.alt}
                  width="1600"
                  height="1000"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  onerror="this.style.display='none'"
                />
              </div>
              <div class="tour-copy">
                <div class="tour-copy-head">
                  <h3>{item.title}</h3>
                  <a class="tour-dl-link" href="/download">
                    <Download size={12} /> Download Hero Notch
                  </a>
                </div>
                <p>{item.caption}</p>
                <span class="notice">{item.notice}</span>
              </div>
              <div class="tour-progress" aria-hidden="true">
                {tour.map((dot) => <span class:list={{ 'is-active': dot.id === item.id }} />)}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .tour-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tour-chrome-title {
    color: rgba(255, 255, 255, 0.78);
  }

  .tour-chrome-hint {
    color: rgba(255, 255, 255, 0.38);
  }

  .tour-media img {
    filter: grayscale(1) contrast(1.08) brightness(0.98);
    transition: filter 220ms ease;
  }

  .tour-stage:hover .tour-media img {
    filter: grayscale(0.65) contrast(1.05) brightness(1);
  }

  .tour-pill {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    background: var(--paper-2);
  }

  .tour-copy-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .tour-dl-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--night-ink);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 5px 11px;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .tour-dl-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.45);
  }
</style>

<script>
  const tablist = document.querySelector<HTMLElement>('[role="tablist"]')
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tour-tab]'))
  const panes = Array.from(document.querySelectorAll<HTMLElement>('[data-tour-pane]'))

  const select = (id: string, focus = true): void => {
    for (const tab of tabs) {
      const active = tab.dataset.tourTab === id
      tab.setAttribute('aria-selected', String(active))
      tab.tabIndex = active ? 0 : -1
      if (active && focus) tab.focus()
    }
    for (const pane of panes) {
      pane.hidden = pane.dataset.tourPane !== id
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => select(tab.dataset.tourTab ?? ''))
  }

  tablist?.addEventListener('keydown', (event) => {
    const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true')
    if (current < 0) return
    let next = current
    if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (current + 1) % tabs.length
    else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length
    else if (event.key === 'Home') next = 0
    else if (event.key === 'End') next = tabs.length - 1
    else return
    event.preventDefault()
    select(tabs[next].dataset.tourTab ?? '')
  })
</script>
