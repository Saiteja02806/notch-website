---
import { pricing, formatPrice } from '@/data/pricing'

const earlyPrice = formatPrice(pricing.earlyBird.price)
const standardPrice = formatPrice(pricing.standard.price)
const savePct = Math.round((1 - pricing.earlyBird.price / pricing.standard.price) * 100)
---

<section
  class="hc-hero"
  id="hero-canvas"
  aria-label="Hero Notch interactive OS desktop canvas"
  data-hero-canvas
>
  <div class="hc-grid" aria-hidden="true"></div>
  <div class="hc-vignette" aria-hidden="true"></div>

  <div class="hc-stage" data-hc-stage>
    <!-- ================================================================
         CENTERED HERO ANCHOR (z-index: 20 · Always readable & unobstructed)
         ================================================================ -->
    <div class="hc-center">
      <div class="hc-center__inner">
        <span class="hc-eyebrow">
          <span class="hc-eyebrow__dot" aria-hidden="true"></span>
          MACOS &amp; WINDOWS · EARLY BIRD PREBOOK
        </span>

        <h1 class="hc-title">Hero Notch</h1>

        <p class="hc-subtitle">
          a quiet command workspace that lives at the top edge of your screen.
        </p>

        <div class="hc-os-actions" role="group" aria-label="Unlock Hero Notch by platform">
          <div class="hc-os-choice">
            <a class="hc-pill hc-pill--mac" href="/pricing?os=mac">
              <svg class="hc-os-glyph" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
                <path d="M11.182 8.51c-.015-1.57 1.283-2.327 1.341-2.363-.73-1.068-1.867-1.214-2.271-1.231-.967-.098-1.887.569-2.378.569-.49 0-1.248-.555-2.05-.54-1.055.015-2.027.613-2.57 1.556-1.096 1.9-.28 4.715.788 6.257.522.755 1.144 1.604 1.96 1.574.787-.031 1.084-.509 2.035-.509.951 0 1.218.509 2.05.493.847-.015 1.383-.77 1.903-1.525.6-.876.847-1.724.862-1.769-.019-.008-1.655-.635-1.67-2.512zm-1.564-4.62c.433-.525.725-1.254.645-1.98-.624.025-1.379.416-1.827.94-.401.464-.752 1.207-.658 1.92.697.054 1.407-.355 1.84-.88z" />
              </svg>
              <span>Prebook for MacBook · {earlyPrice}</span>
            </a>
            <span class="hc-os-caption">macOS 13+ · Coming soon</span>
          </div>

          <div class="hc-os-choice">
            <a class="hc-pill hc-pill--win" href="/pricing?os=win">
              <svg class="hc-os-glyph" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M1.5 1.5h5.8v5.8H1.5V1.5zm7.2 0h5.8v5.8H8.7V1.5zM1.5 8.7h5.8v5.8H1.5V8.7zm7.2 0h5.8v5.8H8.7V8.7z" />
              </svg>
              <span>Prebook for Windows · {earlyPrice}</span>
            </a>
            <span class="hc-os-caption">Windows 10 &amp; 11 · Coming soon</span>
          </div>
        </div>

        <div class="hc-urgency" aria-label={`Early Bird ${earlyPrice} now, then ${standardPrice} at launch, save ${savePct} percent`}>
          <span class="hc-urgency__was" aria-hidden="true">{standardPrice}</span>
          <span class="hc-urgency__copy">
            Now <strong>{earlyPrice}</strong> · <strong>then {standardPrice}</strong> at launch
          </span>
          <span class="hc-urgency__badge">-{savePct}%</span>
        </div>

        <nav class="hc-jumps" aria-label="Page sections and canvas controls">
          <a class="hc-jump-link" href="#details">See All Capabilities ↓</a>
          <span class="hc-jump-sep hc-jump-sep--desktop" data-reset-sep aria-hidden="true" hidden>·</span>
          <button type="button" class="hc-reset-btn" data-reset-canvas hidden>
            Reset Canvas Layout
          </button>
        </nav>
      </div>
    </div>

    <!-- ================================================================
         QUIET FLOATING CAPABILITY TAGS & RIGHT-SIDE EDITORIAL TEXT NOTES
         ================================================================ -->
    <div class="hc-artifacts" aria-label="Additional Hero Notch capabilities">
      <span class="hc-kaomoji hc-kaomoji--tl">[spotify + system media]</span>
      <span class="hc-kaomoji hc-kaomoji--tr">[focus blur · auto-hide]</span>
      <span class="hc-kaomoji hc-kaomoji--bl">[hydration + focus timer]</span>
      <span class="hc-kaomoji hc-kaomoji--br">[7 modular surfaces]</span>

      <div class="hc-side-notes">
        <div class="hc-side-note">
          <span class="hc-side-note__title">Connect Google Calendar</span>
          <span class="hc-side-note__sub">12s under-notch alerts · never steals focus</span>
        </div>
      </div>
    </div>

    <!-- ================================================================
         DRAGGABLE & INTERACTIVE OS WINDOWS (z-index: 12..19)
         ================================================================ -->
    <div class="hc-windows-layer">
      <!-- 1. Floating Window 1: notes-vault.md (Top-Left) -->
      <article
        class="hc-win hc-win--notes"
        data-drag-win="notes"
        data-hc-win-module="notes"
        style="z-index: 14"
        aria-label="Interactive Obsidian Markdown checklist window"
      >
        <header class="hc-win__bar" title="Drag window">
          <div class="hc-win__dots" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <span class="hc-win__title">notes-vault.md</span>
          <span class="hc-win__badge" data-hc-save-badge aria-live="polite">750ms saved</span>
        </header>

        <div class="hc-win__body hc-notes-body">
          <div class="hc-notes-meta">
            <span class="hc-notes-path">~/daily/launch.md</span>
            <span class="hc-notes-progress" data-hc-todo-count>1/3 done</span>
          </div>

          <ul class="hc-todo-list">
            <li>
              <label class="hc-todo is-done">
                <input type="checkbox" checked data-hc-todo />
                <span class="hc-todo__box" aria-hidden="true"></span>
                <span class="hc-todo__syntax" data-hc-md-prefix>- [x]</span>
                <span class="hc-todo__text">Mount Obsidian vault</span>
              </label>
            </li>
            <li>
              <label class="hc-todo">
                <input type="checkbox" data-hc-todo />
                <span class="hc-todo__box" aria-hidden="true"></span>
                <span class="hc-todo__syntax" data-hc-md-prefix>- [ ]</span>
                <span class="hc-todo__text">750ms auto-save</span>
              </label>
            </li>
            <li>
              <label class="hc-todo">
                <input type="checkbox" data-hc-todo />
                <span class="hc-todo__box" aria-hidden="true"></span>
                <span class="hc-todo__syntax" data-hc-md-prefix>- [ ]</span>
                <span class="hc-todo__text">Ctrl+K search</span>
              </label>
            </li>
          </ul>
        </div>
      </article>

      <!-- 2. Floating Window 2: setup-notes.mp4 (Upper-Left-Inner) -->
      <article
        class="hc-win hc-win--clip-notes"
        data-drag-win="notes-video"
        style="z-index: 13"
        aria-label="Live Obsidian notes preview clip"
      >
        <header class="hc-win__bar" title="Drag window">
          <div class="hc-win__dots" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <span class="hc-win__title">setup-notes.mp4</span>
          <a class="hc-win__jump" href="#setup-video" title="Jump to full 51s video">51s ↗</a>
        </header>

        <div class="hc-win__video-wrap">
          <video
            class="hc-win__video"
            src="/media/hero-notch-setup.mp4#t=4,11"
            poster="/media/hero-notch-poster.webp"
            muted
            autoplay
            loop
            playsinline
            preload="metadata"
            data-clip-start="4"
            data-clip-end="11"
            aria-label="Silent preview of live Obsidian Markdown editing inside Hero Notch"
          ></video>
        </div>

        <footer class="hc-win__foot">
          <span class="hc-win__filename">obsidian-live-edit.mp4</span>
          <a class="hc-win__foot-btn" href="#setup-video">Watch ↓</a>
        </footer>
      </article>

      <!-- 3. Floating Window 3: display-setup.mp4 (Top-Right) -->
      <article
        class="hc-win hc-win--clip-display"
        data-drag-win="display-video"
        style="z-index: 15"
        aria-label="Live display placement preview clip"
      >
        <header class="hc-win__bar" title="Drag window">
          <div class="hc-win__dots" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <span class="hc-win__title">display-setup.mp4</span>
          <a class="hc-win__jump" href="#setup-video" title="Jump to Display Setup chapter">Act 05 ↗</a>
        </header>

        <div class="hc-win__video-wrap">
          <video
            class="hc-win__video"
            src="/media/hero-notch-setup.mp4#t=37,46"
            poster="/media/hero-notch-poster.webp"
            muted
            autoplay
            loop
            playsinline
            preload="metadata"
            data-clip-start="37"
            data-clip-end="46"
            aria-label="Silent preview of Hero Notch display placement and cross-platform settings"
          ></video>
        </div>

        <footer class="hc-win__foot">
          <span class="hc-win__filename">mac-win-placement.mp4</span>
          <a class="hc-win__foot-btn" href="#setup-video">Open ↓</a>
        </footer>
      </article>

      <!-- 4. Floating Window 4: ai-sessions.sys (Bottom-Left) -->
      <article
        class="hc-win hc-win--agents"
        data-drag-win="agents"
        data-hc-win-module="sessions"
        style="z-index: 16"
        aria-label="Interactive multi-agent coding sessions switcher"
      >
        <header class="hc-win__bar" title="Drag window">
          <div class="hc-win__dots" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <span class="hc-win__title">ai-sessions.sys</span>
          <span class="hc-win__badge hc-win__badge--live">
            <i aria-hidden="true"></i> 4 LOCAL
          </span>
        </header>

        <div class="hc-win__body hc-agents-body">
          <div class="hc-agent-pills" role="tablist" aria-label="Select AI coding agent session">
            <button
              type="button"
              role="tab"
              aria-selected="true"
              class="hc-agent-pill is-active"
              data-hc-agent="claude"
            >
              Claude Code
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              class="hc-agent-pill"
              data-hc-agent="codex"
            >
              Codex
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              class="hc-agent-pill"
              data-hc-agent="opencode"
            >
              OpenCode
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              class="hc-agent-pill"
              data-hc-agent="antigravity"
            >
              Anti Gravity
            </button>
          </div>

          <div class="hc-agent-readout" data-hc-agent-readout>
            <div class="hc-agent-readout__top">
              <span class="hc-agent-model" data-hc-agent-model>claude-sonnet-4 · jsonl</span>
              <span class="hc-agent-tokens" data-hc-agent-tokens>14.2k tok</span>
            </div>
            <p class="hc-agent-turn" data-hc-agent-turn>
              &gt; Patching top-edge overlay &amp; auto-save hooks…
            </p>
            <span class="hc-agent-state" data-hc-agent-state>
              ● STREAMING · reply ready in notch
            </span>
          </div>
        </div>
      </article>

      <!-- 5. Floating Frameless Video: Posture Correction (Bottom-Right) -->
      <div
        class="hc-posture-video-card"
        aria-label="Posture correction live webcam demo"
      >
        <div class="hc-posture-video-box">
          <video
            class="hc-win__video"
            src="/media/posture-demo.mp4"
            poster="/media/posture-demo-poster.webp"
            muted
            autoplay
            playsinline
            preload="auto"
            data-hc-posture-video
            aria-label="Live webcam demo of Hero Notch posture correction"
          ></video>

          <button
            type="button"
            class="hc-posture-play-overlay"
            data-hc-posture-play
            aria-label="Play posture correction video"
            hidden
          >
            <span class="hc-posture-play-icon" aria-hidden="true">▶</span>
          </button>
        </div>
        <a class="hc-posture-video-label" href="#posture-coach">Posture correction</a>
      </div>
    </div>

    <!-- ================================================================
         BOTTOM-PEEK TRANSITION -> #setup-video
         ================================================================ -->
    <div class="hc-peek-wrap">
      <a class="hc-bottom-peek" href="#setup-video">
        <span class="hc-bottom-peek__notch" aria-hidden="true">
          <i></i>
        </span>
        <span class="hc-bottom-peek__label">Watch 51s Full Setup Video</span>
        <span class="hc-bottom-peek__hint">Scroll or click ↓</span>
      </a>
    </div>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLElement>('[data-hero-canvas]')
  if (canvas) {
    const stage = canvas.querySelector<HTMLElement>('[data-hc-stage]')
    const windows = Array.from(canvas.querySelectorAll<HTMLElement>('[data-drag-win]'))
    const resetBtn = canvas.querySelector<HTMLButtonElement>('[data-reset-canvas]')
    const resetSep = canvas.querySelector<HTMLElement>('[data-reset-sep]')
    let resetFeedbackActive = false

    // ------------------------------------------------------------------
    // 1. PointerEvent Window Dragging & z-index Elevation (z-index 12..19)
    // ------------------------------------------------------------------
    const offsets = new WeakMap<HTMLElement, { x: number; y: number }>()

    const isCanvasChanged = (): boolean => {
      return windows.some((win) => {
        const pos = offsets.get(win)
        return Boolean(pos && (Math.abs(pos.x) > 1 || Math.abs(pos.y) > 1))
      })
    }

    const syncResetVisibility = (): void => {
      if (!resetBtn) return
      const show = resetFeedbackActive || isCanvasChanged()
      resetBtn.hidden = !show
      if (resetSep) resetSep.hidden = !show
    }
    const baseOrder = [
      'notes-video',
      'notes',
      'display-video',
      'agents'
    ]
    let zOrder = [...windows].sort((a, b) => {
      return baseOrder.indexOf(a.dataset.dragWin ?? '') - baseOrder.indexOf(b.dataset.dragWin ?? '')
    })

    const applyZStack = (): void => {
      const startZ = 19 - Math.max(0, zOrder.length - 1)
      zOrder.forEach((win, idx) => {
        const clamped = Math.min(19, Math.max(12, startZ + idx))
        win.style.zIndex = String(clamped)
      })
    }

    const bringToFront = (win: HTMLElement): void => {
      zOrder = [...zOrder.filter((item) => item !== win), win]
      applyZStack()
    }

    for (const win of windows) {
      offsets.set(win, { x: 0, y: 0 })

      win.addEventListener('pointerdown', () => {
        bringToFront(win)
      })

      const bar = win.querySelector<HTMLElement>('.hc-win__bar')
      if (!bar) continue

      let activePointerId: number | null = null
      let startClientX = 0
      let startClientY = 0
      let originX = 0
      let originY = 0
      let minDx = -Infinity
      let maxDx = Infinity
      let minDy = -Infinity
      let maxDy = Infinity

      bar.addEventListener('pointerdown', (e: PointerEvent) => {
        if (e.button !== 0 && e.pointerType === 'mouse') return
        if ((e.target as HTMLElement).closest('button, a, input, label')) return
        if (window.getComputedStyle(win).position !== 'absolute') return

        e.preventDefault()
        bringToFront(win)

        const current = offsets.get(win) ?? { x: 0, y: 0 }
        originX = current.x
        originY = current.y
        startClientX = e.clientX
        startClientY = e.clientY
        activePointerId = e.pointerId

        if (stage) {
          const stageRect = stage.getBoundingClientRect()
          const winRect = win.getBoundingClientRect()
          const pad = 48
          minDx = stageRect.left - winRect.left - winRect.width + pad
          maxDx = stageRect.right - winRect.right + winRect.width - pad
          minDy = stageRect.top - winRect.top
          maxDy = stageRect.bottom - winRect.bottom - 18
        }

        win.classList.remove('is-resetting')
        win.classList.add('is-dragging')
        try {
          bar.setPointerCapture(e.pointerId)
        } catch {
          // Pointer capture may fail in synthetic test events; dragging still works.
        }
      })

      bar.addEventListener('pointermove', (e: PointerEvent) => {
        if (activePointerId !== e.pointerId) return
        const rawDx = e.clientX - startClientX
        const rawDy = e.clientY - startClientY
        const dx = Math.min(maxDx, Math.max(minDx, rawDx))
        const dy = Math.min(maxDy, Math.max(minDy, rawDy))
        const nextX = originX + dx
        const nextY = originY + dy
        offsets.set(win, { x: nextX, y: nextY })
        win.style.transform = `translate3d(${nextX}px, ${nextY}px, 0)`
        syncResetVisibility()
      })

      const stopDrag = (e: PointerEvent): void => {
        if (activePointerId !== e.pointerId) return
        activePointerId = null
        win.classList.remove('is-dragging')
        try {
          if (bar.hasPointerCapture(e.pointerId)) {
            bar.releasePointerCapture(e.pointerId)
          }
        } catch {
          // Ignore already-released pointer captures.
        }
      }

      bar.addEventListener('pointerup', stopDrag)
      bar.addEventListener('pointercancel', stopDrag)
    }

    if (resetBtn) {
      let resetTimer: number | undefined
      const defaultLabel = resetBtn.textContent?.trim() || 'Reset Canvas Layout'

      resetBtn.addEventListener('click', () => {
        zOrder = [...windows].sort((a, b) => {
          return baseOrder.indexOf(a.dataset.dragWin ?? '') - baseOrder.indexOf(b.dataset.dragWin ?? '')
        })
        applyZStack()

        for (const win of windows) {
          offsets.set(win, { x: 0, y: 0 })
          win.classList.add('is-resetting')
          win.style.transform = 'translate3d(0px, 0px, 0px)'
          window.setTimeout(() => win.classList.remove('is-resetting'), 340)
        }

        resetFeedbackActive = true
        resetBtn.textContent = 'Layout reset ✓'
        syncResetVisibility()
        window.clearTimeout(resetTimer)
        resetTimer = window.setTimeout(() => {
          resetFeedbackActive = false
          resetBtn.textContent = defaultLabel
          syncResetVisibility()
        }, 900)
      })
    }

    // ------------------------------------------------------------------
    // 2. Window 1: Obsidian Markdown Checklist & 750ms Save Flash
    // ------------------------------------------------------------------
    const todoInputs = Array.from(canvas.querySelectorAll<HTMLInputElement>('[data-hc-todo]'))
    const todoCountEl = canvas.querySelector<HTMLElement>('[data-hc-todo-count]')
    const saveBadgeEl = canvas.querySelector<HTMLElement>('[data-hc-save-badge]')
    let saveFlashTimer: number | undefined

    const syncTodos = (triggerSave: boolean): void => {
      const done = todoInputs.filter((input) => input.checked).length
      if (todoCountEl) {
        todoCountEl.textContent = `${done}/${todoInputs.length} done`
      }
      for (const input of todoInputs) {
        const label = input.closest('.hc-todo')
        const prefix = label?.querySelector<HTMLElement>('[data-hc-md-prefix]')
        label?.classList.toggle('is-done', input.checked)
        if (prefix) {
          prefix.textContent = input.checked ? '- [x]' : '- [ ]'
        }
      }
      if (triggerSave && saveBadgeEl) {
        saveBadgeEl.textContent = 'Saving…'
        saveBadgeEl.classList.add('is-flashing')
        window.clearTimeout(saveFlashTimer)
        saveFlashTimer = window.setTimeout(() => {
          saveBadgeEl.textContent = '750ms saved ✓'
          window.setTimeout(() => {
            saveBadgeEl.classList.remove('is-flashing')
            saveBadgeEl.textContent = '750ms saved'
          }, 900)
        }, 260)
      }
    }

    for (const input of todoInputs) {
      input.addEventListener('change', () => syncTodos(true))
    }
    syncTodos(false)

    // ------------------------------------------------------------------
    // 3. Windows 2, 3 & 5: Silent Video Clip & Loop Playback Guard
    // ------------------------------------------------------------------
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const mobileMq = window.matchMedia('(max-width: 767px)')
    const clipVideos = Array.from(
      canvas.querySelectorAll<HTMLVideoElement>('video[data-clip-start][data-clip-end]')
    )
    const postureVideo = canvas.querySelector<HTMLVideoElement>('[data-hc-posture-video]')
    const posturePlayBtn = canvas.querySelector<HTMLButtonElement>('[data-hc-posture-play]')
    let postureHasEnded = false

    const forceAutoplay = (vid: HTMLVideoElement, loop: boolean): void => {
      vid.muted = true
      vid.defaultMuted = true
      vid.playsInline = true
      vid.loop = loop
      void vid.play().catch(() => undefined)
    }

    const syncPostureOverlay = (): void => {
      if (!postureVideo || !posturePlayBtn) return
      posturePlayBtn.hidden = !postureVideo.paused && !postureVideo.ended
    }

    const syncClipPlayback = (): void => {
      const pauseClips = reducedMotion || mobileMq.matches
      for (const vid of clipVideos) {
        if (pauseClips) {
          vid.pause()
        } else {
          forceAutoplay(vid, true)
        }
      }
      if (postureVideo) {
        if (mobileMq.matches) {
          postureVideo.pause()
        } else if (!postureHasEnded) {
          forceAutoplay(postureVideo, false)
        }
        syncPostureOverlay()
      }
    }

    if (postureVideo) {
      postureVideo.addEventListener('canplay', () => {
        if (!mobileMq.matches && !postureHasEnded && postureVideo.paused) {
          forceAutoplay(postureVideo, false)
        }
      })
      postureVideo.addEventListener('play', syncPostureOverlay)
      postureVideo.addEventListener('pause', syncPostureOverlay)
      postureVideo.addEventListener('ended', () => {
        postureHasEnded = true
        syncPostureOverlay()
      })
      posturePlayBtn?.addEventListener('click', () => {
        postureHasEnded = false
        if (postureVideo.ended || postureVideo.currentTime >= (postureVideo.duration || 0) - 0.1) {
          postureVideo.currentTime = 0
        }
        forceAutoplay(postureVideo, false)
      })
    }
    for (const vid of clipVideos) {
      const start = Number(vid.dataset.clipStart)
      const end = Number(vid.dataset.clipEnd)
      if (!Number.isFinite(start) || !Number.isFinite(end)) continue

      vid.addEventListener('loadedmetadata', () => {
        if (vid.currentTime < start || vid.currentTime >= end) {
          vid.currentTime = start
        }
        if (!reducedMotion && !mobileMq.matches) {
          void vid.play().catch(() => undefined)
        } else {
          vid.pause()
        }
      })

      vid.addEventListener('timeupdate', () => {
        if (vid.currentTime >= end - 0.12 || vid.currentTime < start - 0.5) {
          vid.currentTime = start
        }
      })
    }
    syncClipPlayback()
    mobileMq.addEventListener?.('change', syncClipPlayback)

    // ------------------------------------------------------------------
    // 4. Window 4: AI Sessions Interactive Agent Switcher
    // ------------------------------------------------------------------
    const agentData: Record<
      string,
      { model: string; tokens: string; turn: string; state: string }
    > = {
      claude: {
        model: 'claude-sonnet-4 · jsonl',
        tokens: '14.2k tok',
        turn: '> Patching top-edge overlay & auto-save hooks…',
        state: '● STREAMING · reply ready in notch'
      },
      codex: {
        model: 'gpt-5-codex · sqlite',
        tokens: '9.8k tok',
        turn: '> Checking MacBook notch + Win11 DPI bounds',
        state: '● WATCHING · 0 warnings across 4 files'
      },
      opencode: {
        model: 'opencode-local · ipc',
        tokens: '6.4k tok',
        turn: '> Approve tool call: npm run build',
        state: '● APPROVAL · press Enter or reply in notch'
      },
      antigravity: {
        model: 'gemini-2.5-pro · local',
        tokens: '11.7k tok',
        turn: '> Syncing ~/HeroNotchVault [[wiki-links]]',
        state: '● SYNCED · read-only local session board'
      }
    }

    const agentPills = Array.from(canvas.querySelectorAll<HTMLButtonElement>('[data-hc-agent]'))
    const agentModelEl = canvas.querySelector<HTMLElement>('[data-hc-agent-model]')
    const agentTokensEl = canvas.querySelector<HTMLElement>('[data-hc-agent-tokens]')
    const agentTurnEl = canvas.querySelector<HTMLElement>('[data-hc-agent-turn]')
    const agentStateEl = canvas.querySelector<HTMLElement>('[data-hc-agent-state]')

    for (const pill of agentPills) {
      pill.addEventListener('click', () => {
        const key = pill.dataset.hcAgent ?? 'claude'
        const info = agentData[key]
        if (!info) return

        for (const p of agentPills) {
          const active = p === pill
          p.classList.toggle('is-active', active)
          p.setAttribute('aria-selected', String(active))
        }

        if (agentModelEl) agentModelEl.textContent = info.model
        if (agentTokensEl) agentTokensEl.textContent = info.tokens
        if (agentTurnEl) agentTurnEl.textContent = info.turn
        if (agentStateEl) agentStateEl.textContent = info.state
      })
    }
  }
</script>

