---
import Wordmark from './Wordmark.astro'
import { site } from '@/data/site'
import { release } from '@/data/release'

const product = [
  { href: '/#hero-canvas', label: 'Interactive Canvas' },
  { href: '/#setup-video', label: 'Setup Video (51s)' },
  { href: '/#details', label: 'Capabilities' },
  { href: '/#install', label: 'Setup Guide' },
  { href: '/pricing', label: 'Pricing' }
]

const access = [
  { href: '/pricing', label: 'Prebook Early Bird ($3.99)' },
  { href: '/download', label: 'Prebook & License Key' }
]

const help = [
  { href: '/help', label: 'Help centre' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: `mailto:${site.email}`, label: 'Contact' }
]
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <Wordmark />
        <p>{site.tagline} A one-time-license app for macOS and Windows that keeps music, notes, plans, posture and your AI sessions one hover away.</p>
        <span class="chip chip--live">v{release.version} · macOS &amp; Windows</span>
      </div>

      <div class="footer-col">
        <h4>Product</h4>
        <ul>
          {product.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Access</h4>
        <ul>
          {access.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Help</h4>
        <ul>
          {help.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer-fine">
      <p>
        Hero Notch is an independent project, not affiliated with Apple, Microsoft, Spotify, OpenAI, Obsidian or any other
        product it integrates with. Product names are used only to describe compatibility.
      </p>
      <div class="row">
        <span>© {site.year} {site.author}. Built with Astro.</span>
        <span>One-time license · macOS &amp; Windows · Local-first</span>
      </div>
    </div>
  </div>
</footer>
