    color: rgba(255, 255, 255, 0.18);
    margin-right: 10px;
  }

  .desk-code-lines b {
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
  }

  .desk-code-lines em {
    font-style: normal;
    color: rgba(255, 255, 255, 0.58);
  }

  .desk-terminal {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 9.8px;
  }

  .desk-term-head {
    display: flex;
    justify-content: space-between;
    color: rgba(255, 255, 255, 0.35);
    font-size: 9px;
    letter-spacing: 0.06em;
  }

  .desk-term-lines {
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: rgba(255, 255, 255, 0.55);
  }

  .term-ok {
    color: rgba(255, 255, 255, 0.8);
  }

  .desk-md-title {
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
  }

  .desk-md-p {
    font-family: var(--sans);
    font-size: 11.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.42);
  }

  .desk-md-checks {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: auto;
    font-size: 10.2px;
