    color: rgba(255, 255, 255, 0.75);
    font-size: 9px;
  }

  .save-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ffffff;
  }

  .ne-obsidian-btn {
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #ffffff;
    font-size: 9px;
  }

  .ne-content {
