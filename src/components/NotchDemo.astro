---
/**
 * Scroll-driven & click-driven "Watch it work" interactive showcase.
 * Demonstrates how Hero Notch sits as a quiet 34px hardware-style sliver at the
 * top center of a MacBook Pro or Windows 11 display, then unfolds across the top
 * edge into a full-scale personal workspace (Dashboard, Obsidian Notes Vault,
 * Multi-Agent Coding Sessions, Google Calendar & 12s Under-Notch Reminder,
 * Native SMTC + Spotify Queue Media Deck, and On-Device Posture + Hydration + Phone QR).
 */
interface Scene {
  id: string
  num: string
  pill: string
  label: string
  title: string
  note: string
}

const scenes: Scene[] = [
  {
    id: 'closed',
    num: '01',
    pill: 'Collapsed',
    label: '01 · Collapsed Notch',
    title: 'Collapsed, it is thirty-four pixels of quiet.',
    note: 'Flush with the top center edge of your MacBook Pro or Windows 11 monitor. Live timer, audio waveform and active agent count stay visible at a glance while your desktop stays 100% sharp.'
  },
  {
    id: 'home',
    num: '02',
    pill: 'Dashboard',
    label: '02 · Personal Dashboard',
    title: 'Unfolds into a full-width top-edge command deck.',
    note: 'Hover or press your shortcut and the notch expands smoothly across the top of your screen — bringing your Focus Timer, Now Playing deck, and Today’s Tasks together while gently blurring background windows.'
  },
  {
    id: 'notes',
    num: '03',
    pill: 'Notes Vault',
    label: '03 · Notes · Obsidian & Markdown',
    title: 'Your local Obsidian vault, live inside the notch.',
    note: 'Point it at any local folder of .md files. Browse your sidebar, search with Ctrl+K, check off tasks, and write with 750ms debounced auto-save and one-click Open in Obsidian.'
  },
  {
    id: 'sessions',
    num: '04',
    pill: 'AI Sessions',
    label: '04 · Multi-Agent Coding Board',
    title: 'Claude Code, Codex, OpenCode & Anti Gravity on one board.',
    note: 'Watch live turns, active models, and token velocity across every coding agent running on your machine. Catch OpenCode bash approval prompts and send verified follow-up replies straight from the notch.'
  },
  {
    id: 'plan',
    num: '05',
    pill: 'Plan & Calendar',
    label: '05 · Google Calendar & 12s Reminders',
    title: 'Google Calendar agenda & 12-second under-notch alerts.',
    note: 'See your month calendar, timed tasks, and live Google Calendar events side-by-side. When a meeting starts soon, a compact card unfolds beneath the notch for 12 seconds without stealing keyboard focus.'
  },
  {
    id: 'music',
    num: '06',
    pill: 'Music Deck',
    label: '06 · Native Media & Spotify Queue',
    title: 'Zero-setup system media control, plus your Spotify queue.',
    note: 'Native OS media sessions and album art appear automatically with zero configuration. Connect optional PKCE Spotify to browse Up Next, scrub tracks, and control playback.'
  },
  {
    id: 'posture',
    num: '07',
    pill: 'Posture & Phone QR',
    label: '07 · Posture, Hydration & LAN Phone QR',
    title: 'On-device posture coach, water tracker & two-way Phone QR.',
    note: 'Camera frames are scored 0–100 in RAM and discarded immediately. Alongside it: an 8-glass hydration tracker and instant local Wi-Fi QR transfer (up to 16 MB) between phone and PC.'
  }
]
---

<section class="demo" id="demo" data-demo>
  <div class="wrap">
    <div class="section-head demo-head">
      <span class="eyebrow"><span class="dot"></span> Watch it work</span>
      <h2 class="h2">Seven states, one strip of screen.</h2>
      <p class="lede">
        Scroll through the timeline or click any state below to watch Hero Notch unfold from a 34-pixel
        hardware sliver into a full-scale top-edge workspace — on both <strong>Windows 11</strong> and <strong>macOS</strong>.
      </p>
    </div>
  </div>

  <div class="demo-track" data-demo-track style={`--steps:${scenes.length}`}>
    {/* Scroll anchors for every scene plus legacy #demo-styles alias */}
    {scenes.map((scene, i) => (
      <span
        id={`demo-${scene.id}`}
        aria-hidden="true"
        class="demo-anchor"
        style={`top: calc(((var(--steps) * var(--demo-step)) - 100vh) / (var(--steps) - 1) * ${i})`}
      ></span>
    ))}
    <span
      id="demo-styles"
      aria-hidden="true"
      class="demo-anchor"
      style={`top: calc(((var(--steps) * var(--demo-step)) - 100vh))`}
    ></span>

    <div class="demo-sticky">
      {/* Top interactive control bar: Scene Pills + OS Switcher */}
      <div class="demo-toolbar" role="toolbar" aria-label="Notch demo states and operating system switcher">
        <div class="demo-scene-pills" role="tablist" aria-label="Notch states">
          {scenes.map((scene, idx) => (
            <button
              type="button"
              role="tab"
              class={`demo-scene-pill ${idx === 0 ? 'is-on' : ''}`}
              data-demo-pill={scene.id}
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <span class="pill-num">{scene.num}</span>
              <span class="pill-text">{scene.pill}</span>
            </button>
          ))}
        </div>

        <div class="demo-os-switch" role="group" aria-label="Preview operating system">
          <button type="button" class="demo-os-btn is-on" data-os-btn="mac">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.18 8.53c-.02-1.57 1.28-2.33 1.34-2.37-.73-1.07-1.87-1.22-2.27-1.23-.96-.1-1.89.57-2.38.57-.5 0-1.25-.56-2.06-.54-1.05.02-2.03.61-2.57 1.56-1.1 1.91-.28 4.73.79 6.28.52.76 1.15 1.61 1.97 1.58.79-.03 1.09-.51 2.05-.51.95 0 1.23.51 2.06.49.86-.01 1.39-.77 1.91-1.53.61-.89.86-1.75.87-1.8-.02-.01-1.69-.65-1.71-2.5zM9.62 3.89c.43-.53.73-1.26.65-2-.63.03-1.39.42-1.84.94-.4.46-.75 1.21-.66 1.92.7.05 1.42-.35 1.85-.86z"/></svg>
            <span>MacBook Pro · macOS</span>
          </button>
          <button type="button" class="demo-os-btn" data-os-btn="win">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.5 2.5h5.8v5.8H1.5V2.5zm6.7 0h6.3v5.8H8.2V2.5zM1.5 9.2h5.8v5.8H1.5V9.2zm6.7 0h6.3v5.8H8.2V9.2z"/></svg>
            <span>Windows 11 · Studio</span>
          </button>
        </div>
      </div>

      <div class="demo-device" data-demo-device data-os="mac" data-active-scene="closed">
        <div class="demo-screen">
          {/* Desktop wallpaper & realistic multi-window workspace behind the notch */}
          <div class="demo-wall" aria-hidden="true">
            <div class="demo-desktop-windows">
              {/* Left Desktop Window: Code Editor + Terminal */}
              <div class="desk-win desk-win-code">
                <div class="desk-win-bar">
                  <div class="desk-win-dots">
                    <span></span><span></span><span></span>
                  </div>
                  <span class="desk-win-title">NotchController.ts — notch-workspace</span>
                  <span class="desk-win-tag">TypeScript · UTF-8</span>
                </div>
                <div class="desk-win-body">
                  <div class="desk-code-lines">
                    <span><i>01</i> <b>import</b> &#123; mountVault, watchAgents &#125; <b>from</b> <em>'@notch/core'</em></span>
                    <span><i>02</i> <b>import</b> &#123; syncCalendarAgenda &#125; <b>from</b> <em>'@notch/calendar'</em></span>
                    <span><i>03</i></span>
                    <span><i>04</i> <b>export async function</b> bootTopEdgeIsland(display = <em>'primary'</em>) &#123;</span>
                    <span><i>05</i> &nbsp;&nbsp;<b>const</b> vault = <b>await</b> mountVault(<em>'~/Documents/obsidian-vault'</em>, &#123; debounceMs: 750 &#125;)</span>
                    <span><i>06</i> &nbsp;&nbsp;<b>const</b> sessions = watchAgents([<em>'claude-code'</em>, <em>'codex'</em>, <em>'opencode'</em>, <em>'antigravity'</em>])</span>
                    <span><i>07</i> &nbsp;&nbsp;<b>return</b> &#123; vault, sessions, focusBlur: <b>true</b>, ramOnlyPosture: <b>true</b> &#125;</span>
                    <span><i>08</i> &#125;</span>
                  </div>
                  <div class="desk-terminal">
                    <div class="desk-term-head">
                      <span>TERMINAL · zsh</span>
                      <span>claude-code · active</span>
                    </div>
                    <div class="desk-term-lines">
                      <span>$ npx astro check &amp;&amp; npm run build</span>
                      <span class="term-ok">✓ 0 errors · Built in 1.42s · Watching local vault changes...</span>
                    </div>
                  </div>
                </div>
              </div>

              {/* Right Desktop Window: Obsidian Markdown Note */}
              <div class="desk-win desk-win-notes">
                <div class="desk-win-bar">
                  <div class="desk-win-dots">
                    <span></span><span></span><span></span>
                  </div>
                  <span class="desk-win-title">vault / release-notes.md — Obsidian</span>
                  <span class="desk-win-tag">Synced · Local</span>
                </div>
                <div class="desk-win-body">
                  <div class="desk-md-title"># Hero Notch Architecture</div>
                  <p class="desk-md-p">
                    One top-edge strip replaces floating timers, scattered sticky notes, and buried agent terminals.
                  </p>
                  <div class="desk-md-checks">
                    <span>✓ Plain <code>.md</code> files on disk (750ms debounce)</span>
                    <span>✓ Multi-agent telemetry &amp; reply bridge</span>
                    <span>✓ 12s non-intrusive Google Calendar cards</span>
                    <span>✓ Zero-cloud LAN Phone QR &amp; RAM posture</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Focus Mode Blur Veil when Notch unfolds */}
            <div class="demo-focus-veil">
              <span class="demo-focus-badge">
                <span class="focus-dot"></span>
                Focus Mode · Desktop softly blurred while Notch is expanded
              </span>
            </div>
          </div>

          {/* Top System Menu Bar (Adapts between macOS and Windows 11) */}
          <div class="demo-top" aria-hidden="true">
            <div class="demo-top-left demo-mac-only">
              <svg class="mac-apple" viewBox="0 0 16 16" fill="currentColor"><path d="M11.18 8.53c-.02-1.57 1.28-2.33 1.34-2.37-.73-1.07-1.87-1.22-2.27-1.23-.96-.1-1.89.57-2.38.57-.5 0-1.25-.56-2.06-.54-1.05.02-2.03.61-2.57 1.56-1.1 1.91-.28 4.73.79 6.28.52.76 1.15 1.61 1.97 1.58.79-.03 1.09-.51 2.05-.51.95 0 1.23.51 2.06.49.86-.01 1.39-.77 1.91-1.53.61-.89.86-1.75.87-1.8-.02-.01-1.69-.65-1.71-2.5zM9.62 3.89c.43-.53.73-1.26.65-2-.63.03-1.39.42-1.84.94-.4.46-.75 1.21-.66 1.92.7.05 1.42-.35 1.85-.86z"/></svg>
              <strong>Code</strong>
              <span>File</span>
              <span>Edit</span>
              <span>Selection</span>
              <span>View</span>
              <span>Go</span>
            </div>
            <div class="demo-top-left demo-win-only">
              <span class="win-top-tag">Display 1 · Primary Studio Monitor</span>
              <span class="win-top-muted">Top-Edge Anchor · Auto-Hide Enabled</span>
            </div>

            <div class="demo-top-right">
              <span class="demo-top-pill">Ctrl+K · Instant Open</span>
              <span class="demo-status-icons">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6.5a9 9 0 0 1 12 0M4.5 9a5.5 5.5 0 0 1 7 0M7 11.5a2 2 0 0 1 2 0"/><circle cx="8" cy="13.5" r="0.8" fill="currentColor"/></svg>
                <span class="demo-bat"><i></i></span>
              </span>
              <span class="demo-clock">Tue 12:47</span>
            </div>
          </div>

          {/* THE MORPHING HERO NOTCH ISLAND */}
          <div class="demo-notch" data-island data-scene="closed">
            <div class="island" data-island-box>

              {/* SCENE 1: CLOSED (Sleek 34px Hardware Notch Sliver) */}
              <div class="is-scene is-closed is-active" data-scene-pane="closed" aria-hidden="false">
                <button
                  type="button"
                  class="is-closed-bar"
                  data-open-notch="home"
                  aria-label="Expand Hero Notch Dashboard"
                  title="Click to unfold Hero Notch"
                >
                  <span class="closed-left">
                    <span class="is-closed-dot"></span>
                    <span class="closed-timer">25:00</span>
                    <span class="closed-sep">·</span>
                    <span class="closed-mode">Focus</span>
                  </span>
                  <span class="closed-camera" aria-hidden="true"></span>
                  <span class="closed-right">
                    <span class="is-closed-wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                    <span class="closed-agents">3 agents</span>
                  </span>
                </button>
              </div>

              {/* SCENE 2: HOME (Full Personal Dashboard) */}
              <div class="is-scene is-home" data-scene-pane="home" aria-hidden="true">
                <div class="notch-chrome">
                  <div class="notch-brand">
                    <span class="brand-dot"></span>
                    <strong>Hero Notch</strong>
                    <span class="brand-sub">v1.0.22</span>
                  </div>
                  <div class="notch-tabs">
                    <button type="button" class="n-tab is-on" data-jump-scene="home">Dashboard</button>
                    <button type="button" class="n-tab" data-jump-scene="notes">Notes</button>
                    <button type="button" class="n-tab" data-jump-scene="sessions">Sessions <em>3</em></button>
                    <button type="button" class="n-tab" data-jump-scene="plan">Calendar</button>
                    <button type="button" class="n-tab" data-jump-scene="music">Music</button>
                    <button type="button" class="n-tab" data-jump-scene="posture">Wellness</button>
                  </div>
                  <button type="button" class="notch-collapse-btn" data-jump-scene="closed">
                    <span>Collapse</span>
                    <kbd>Esc</kbd>
                  </button>
                </div>

                <div class="home-grid">
                  {/* Card 1: Focus Timer */}
                  <div class="home-card">
                    <div class="hc-head">
                      <span class="hc-label">FOCUS TIMER</span>
                      <span class="hc-pill">Block 3 / 4</span>
                    </div>
                    <div class="hc-timer-body">
                      <div class="hc-ring-wrap">
                        <svg viewBox="0 0 64 64" class="hc-ring">
                          <circle cx="32" cy="32" r="26" class="hc-ring-bg" />
                          <circle cx="32" cy="32" r="26" class="hc-ring-fg" />
                        </svg>
                        <div class="hc-ring-text">
                          <strong>25:00</strong>
                          <span>DEEP WORK</span>
                        </div>
                      </div>
                      <div class="hc-timer-meta">
                        <span class="hc-task-current">Ship Hero Notch v1.0.22</span>
                        <span class="hc-task-sub">Notifications muted · Blur active</span>
                        <div class="hc-btn-row">
                          <span class="hc-mini-btn is-primary">Pause</span>
                          <span class="hc-mini-btn">+5m</span>
                          <span class="hc-mini-btn">Reset</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Card 2: Now Playing Mini Deck */}
                  <div class="home-card">
                    <div class="hc-head">
                      <span class="hc-label">NOW PLAYING</span>
                      <span class="hc-pill">SMTC · Spotify</span>
                    </div>
                    <div class="hc-music-body">
                      <div class="hc-album-row">
                        <div class="hc-album-art">
                          <span class="hc-vinyl-core"></span>
                        </div>
                        <div class="hc-track-info">
                          <strong>Everything In Its Right Place</strong>
                          <span>Radiohead — Kid A</span>
                        </div>
                      </div>
                      <div class="hc-seek-wrap">
                        <div class="hc-seek-bar"><span style="width: 44%"></span></div>
                        <div class="hc-seek-times">
                          <span>01:48</span>
                          <span>04:11</span>
                        </div>
                      </div>
                      <div class="hc-transport-row">
                        <span>⏮</span>
                        <span class="hc-play-pill">⏸ Playing</span>
                        <span>⏭</span>
                        <span class="hc-queue-hint" data-jump-scene="music">Queue (3) →</span>
                      </div>
                    </div>
                  </div>

                  {/* Card 3: Today's Tasks */}
                  <div class="home-card">
                    <div class="hc-head">
                      <span class="hc-label">TODAY'S TASKS</span>
                      <span class="hc-pill">4 left</span>
                    </div>
                    <div class="hc-tasks-list">
                      <label class="is-task is-done">
                        <input type="checkbox" checked class="is-check-input" />
                        <span class="is-box"></span>
                        <span>Mount local Obsidian <code>.md</code> vault</span>
                      </label>
                      <label class="is-task is-done">
                        <input type="checkbox" checked class="is-check-input" />
                        <span class="is-box"></span>
                        <span>Verify Claude Code &amp; Codex reply bridge</span>
                      </label>
                      <label class="is-task">
                        <input type="checkbox" class="is-check-input" />
                        <span class="is-box"></span>
                        <span>13:00 Architecture Review (Google Meet)</span>
                      </label>
                      <label class="is-task">
                        <input type="checkbox" class="is-check-input" />
                        <span class="is-box"></span>
                        <span>Tag v1.0.22 Mac &amp; Windows release</span>
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              {/* SCENE 3: NOTES (Obsidian & Markdown Vault) */}
              <div class="is-scene is-notes" data-scene-pane="notes" aria-hidden="true">
                <div class="notch-chrome">
                  <div class="notch-brand">
                    <span class="brand-dot"></span>
                    <strong>Hero Notch</strong>
                    <span class="brand-sub">Notes Vault</span>
                  </div>
                  <div class="notch-tabs">
                    <button type="button" class="n-tab" data-jump-scene="home">Dashboard</button>
                    <button type="button" class="n-tab is-on" data-jump-scene="notes">Notes</button>
                    <button type="button" class="n-tab" data-jump-scene="sessions">Sessions <em>3</em></button>
                    <button type="button" class="n-tab" data-jump-scene="plan">Calendar</button>
                    <button type="button" class="n-tab" data-jump-scene="music">Music</button>
                    <button type="button" class="n-tab" data-jump-scene="posture">Wellness</button>
                  </div>
                  <button type="button" class="notch-collapse-btn" data-jump-scene="closed">
                    <span>Collapse</span>
                    <kbd>Esc</kbd>
                  </button>
                </div>

                <div class="notes-workspace">
                  <aside class="notes-sidebar">
                    <div class="ns-folder">
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4.5A1.5 1.5 0 0 1 3.5 3h2.8l1.4 1.5h4.8A1.5 1.5 0 0 1 14 6v6a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12V4.5Z"/></svg>
                      <span>obsidian-vault/</span>
                    </div>
                    <div class="ns-files">
                      <span class="ns-file is-on">roadmap.md</span>
                      <span class="ns-file">ai-sessions.md</span>
                      <span class="ns-file">daily-2026-11-17.md</span>
                      <span class="ns-file">architecture.md</span>
                    </div>
                    <div class="ns-footer">
                      <span>42 files indexed</span>
                      <kbd>Ctrl+K</kbd>
                    </div>
                  </aside>

                  <div class="notes-editor">
                    <div class="ne-toolbar">
                      <span class="ne-path">obsidian-vault / <strong>roadmap.md</strong></span>
                      <span class="ne-save-pill"><i class="save-dot"></i> 750ms auto-saved to disk</span>
                      <span class="ne-obsidian-btn">Open in Obsidian ↗</span>
                    </div>

                    <div class="ne-content">
                      <div class="ne-h1">## Ship Hero Notch 1.0 Release</div>
                      <p class="ne-quote">
                        Plain UTF-8 Markdown files on your local drive. Zero proprietary database, zero cloud lock-in.
                      </p>
                      <div class="ne-checklist">
                        <label class="is-task is-done">
                          <input type="checkbox" checked class="is-check-input" />
                          <span class="is-box"></span>
                          <span>Two-way sync with local <code>obsidian-vault/roadmap.md</code></span>
                        </label>
                        <label class="is-task is-done">
                          <input type="checkbox" checked class="is-check-input" />
                          <span class="is-box"></span>
                          <span>Inline GFM checkboxes, code blocks &amp; <code>Ctrl+K</code> instant switcher</span>
                        </label>
                        <label class="is-task">
                          <input type="checkbox" class="is-check-input" />
                          <span class="is-box"></span>
                          <span>Capture meeting action items from <code>13:00 Architecture Review</code></span>
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* SCENE 4: SESSIONS (Multi-Agent Coding Board) */}
              <div class="is-scene is-sessions" data-scene-pane="sessions" aria-hidden="true">
                <div class="notch-chrome">
                  <div class="notch-brand">
                    <span class="brand-dot"></span>
                    <strong>Hero Notch</strong>
                    <span class="brand-sub">AI Sessions</span>
                  </div>
                  <div class="notch-tabs">
                    <button type="button" class="n-tab" data-jump-scene="home">Dashboard</button>
                    <button type="button" class="n-tab" data-jump-scene="notes">Notes</button>
                    <button type="button" class="n-tab is-on" data-jump-scene="sessions">Sessions <em>3</em></button>
                    <button type="button" class="n-tab" data-jump-scene="plan">Calendar</button>
                    <button type="button" class="n-tab" data-jump-scene="music">Music</button>
                    <button type="button" class="n-tab" data-jump-scene="posture">Wellness</button>
                  </div>
                  <button type="button" class="notch-collapse-btn" data-jump-scene="closed">
                    <span>Collapse</span>
                    <kbd>Esc</kbd>
                  </button>
                </div>

                <div class="sessions-workspace">
                  <div class="sessions-grid">
                    <div class="sess-card is-live">
                      <div class="sess-top">
                        <span class="is-dot is-on"></span>
                        <strong>Claude Code</strong>
                        <span class="sess-model">claude-opus-4-7</span>
                        <span class="is-badge">Delivered</span>
                        <span class="sess-tok">18.2k tok</span>
                      </div>
                      <p class="sess-summary">Refactored NotchDemo.astro morphing controller &amp; verified 0 build errors.</p>
                    </div>

                    <div class="sess-card is-live">
                      <div class="sess-top">
                        <span class="is-dot is-on"></span>
                        <strong>Codex</strong>
                        <span class="sess-model">o3-pro</span>
                        <span class="is-badge">LIVE · Watching</span>
                        <span class="sess-tok">12.4k tok</span>
                      </div>
                      <p class="sess-summary">Streaming SMTC media session metadata &amp; PKCE token refresh state.</p>
                    </div>

                    <div class="sess-card is-approval">
                      <div class="sess-top">
                        <span class="is-dot is-alert"></span>
                        <strong>OpenCode</strong>
                        <span class="sess-model">bash · tool call</span>
                        <span class="is-badge is-badge-alert">Needs Approval</span>
                        <span class="sess-tok">4.9k tok</span>
                      </div>
                      <div class="sess-approval-row">
                        <code>$ npm run astro build -- --verbose</code>
                        <div class="sess-actions">
                          <span class="sess-btn-approve">Approve ↵</span>
