  .ne-h1 {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
  }

  .ne-quote {
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.52);
    border-left: 2px solid rgba(255, 255, 255, 0.28);
