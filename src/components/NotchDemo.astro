  .is-task code {
    font-family: var(--mono);
    font-size: 10px;
    padding: 1px 5px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.09);
    color: #ffffff;
  }

  /* ==========================================================================
     10. SCENE 4: SESSIONS WORKSPACE (Multi-Agent Coding Board)
     ========================================================================== */
  .sessions-workspace {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px 16px;
    gap: 10px;
    min-height: 0;
  }

  .sessions-grid {
    display: grid;
