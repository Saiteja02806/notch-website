<script>
  const root = document.querySelector<HTMLElement>('[data-demo]')
  const track = document.querySelector<HTMLElement>('[data-demo-track]')
  const island = document.querySelector<HTMLElement>('[data-island]')
  const device = document.querySelector<HTMLElement>('[data-demo-device]')

  if (root && track && island && device) {
    if (window.location.hash.startsWith('#demo-')) {
      document.documentElement.style.scrollBehavior = 'auto'
    }

    const labels = Array.from(track.querySelectorAll<HTMLElement>('[data-scene-pane]')).map(
      (pane) => pane.dataset.scenePane ?? ''
    )
    const captionLabel = root.querySelector<HTMLElement>('[data-demo-label]')
    const captionTitle = root.querySelector<HTMLElement>('[data-demo-title]')
    const captionNote = root.querySelector<HTMLElement>('[data-demo-note]')
    const captionCount = root.querySelector<HTMLElement>('[data-demo-count]')
    const segments = Array.from(root.querySelectorAll<HTMLElement>('[data-demo-progress] > span'))
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-demo-tile]'))
    const pills = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-demo-pill]'))
    const osBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-os-btn]'))

    // Interactive checkboxes inside the demo
    for (const input of root.querySelectorAll<HTMLInputElement>('.is-check-input')) {
      input.addEventListener('change', () => {
        input.closest('.is-task')?.classList.toggle('is-done', input.checked)
      })
    }

    // OS Switcher (MacBook Pro vs Windows 11 Studio)
    osBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const os = btn.dataset.osBtn ?? 'mac'
        device.dataset.os = os
        osBtns.forEach((b) => b.classList.toggle('is-on', b === btn))
      })
    })

    const captions: Record<string, { label: string; title: string; note: string }> = {
      closed: {
        label: '01 · Collapsed Notch',
        title: 'Collapsed, it is thirty-four pixels of quiet.',
        note: 'Flush with the top center edge of your MacBook Pro or Windows 11 monitor. Live timer, audio waveform and active agent count stay visible at a glance while your desktop stays 100% sharp.'
      },
      home: {
        label: '02 · Personal Dashboard',
        title: 'Unfolds into a full-width top-edge command deck.',
        note: 'Hover or press your shortcut and the notch expands smoothly across the top of your screen — bringing your Focus Timer, Now Playing deck, and Today’s Tasks together while gently blurring background windows.'
      },
      notes: {
        label: '03 · Notes · Obsidian & Markdown',
        title: 'Your local Obsidian vault, live inside the notch.',
        note: 'Point it at any local folder of .md files. Browse your sidebar, search with Ctrl+K, check off tasks, and write with 750ms debounced auto-save and one-click Open in Obsidian.'
      },
      sessions: {
        label: '04 · Multi-Agent Coding Board',
        title: 'Claude Code, Codex, OpenCode & Anti Gravity on one board.',
        note: 'Watch live turns, active models, and token velocity across every coding agent running on your machine. Catch OpenCode bash approval prompts and send verified follow-up replies straight from the notch.'
      },
      plan: {
        label: '05 · Google Calendar & 12s Reminders',
        title: 'Google Calendar agenda & 12-second under-notch alerts.',
        note: 'See your month calendar, timed tasks, and live Google Calendar events side-by-side. When a meeting starts soon, a compact card unfolds beneath the notch for 12 seconds without stealing keyboard focus.'
      },
      music: {
        label: '06 · Native Media & Spotify Queue',
        title: 'Zero-setup system media control, plus your Spotify queue.',
        note: 'Native OS media sessions and album art appear automatically with zero configuration. Connect optional PKCE Spotify to browse Up Next, scrub tracks, and control playback.'
      },
      posture: {
        label: '07 · Posture, Hydration & LAN Phone QR',
        title: 'On-device posture coach, water tracker & two-way Phone QR.',
        note: 'Camera frames are scored 0–100 in RAM and discarded immediately. Alongside it: an 8-glass hydration tracker and instant local Wi-Fi QR transfer (up to 16 MB) between phone and PC.'
      }
    }

    let current = ''

    const setScene = (id: string): void => {
      const normalized = id === 'styles' ? 'posture' : id
      if (normalized === current) return
      current = normalized
      island.dataset.scene = normalized
      device.dataset.activeScene = normalized

      for (const pane of track.querySelectorAll<HTMLElement>('[data-scene-pane]')) {
        const active = pane.dataset.scenePane === normalized
        pane.classList.toggle('is-active', active)
        pane.setAttribute('aria-hidden', String(!active))
      }

      const caption = captions[normalized] ?? captions.closed
      if (captionLabel) captionLabel.textContent = caption.label
      if (captionTitle) captionTitle.textContent = caption.title
      if (captionNote) captionNote.textContent = caption.note

      const stepIndex = labels.indexOf(normalized)
      if (captionCount && stepIndex >= 0) {
        captionCount.textContent = `${stepIndex + 1} / ${labels.length}`
      }
      segments.forEach((seg, i) => seg.classList.toggle('is-active', i <= stepIndex))
      tiles.forEach((tile) => tile.classList.toggle('is-on', tile.dataset.demoTile === normalized))
      pills.forEach((pill) => {
        const on = pill.dataset.demoPill === normalized
        pill.classList.toggle('is-on', on)
        pill.setAttribute('aria-selected', String(on))
      })
    }

    const scrollToScene = (id: string, behavior: ScrollBehavior = 'smooth'): void => {
      const normalized = id === 'styles' ? 'posture' : id
      const index = labels.indexOf(normalized)
      if (index < 0) return
      const rect = track.getBoundingClientRect()
      const span = rect.height - window.innerHeight
      const target = window.scrollY + rect.top + (index / Math.max(labels.length - 1, 1)) * span
      window.scrollTo({ top: target, behavior })
      setScene(normalized)
    }

    // Scroll drives the story: the tall track maps to the scene sequence.
    let ticking = false
    const onScroll = (): void => {
      if (ticking) return
      ticking = true
      window.requestAnimationFrame(() => {
        ticking = false
        const rect = track.getBoundingClientRect()
        const span = rect.height - window.innerHeight
        if (span <= 0) return
        const progress = Math.min(1, Math.max(0, -rect.top / span))
        const index = Math.min(
          labels.length - 1,
          Math.floor(progress * labels.length + 1e-6)
        )
        setScene(labels[index] ?? 'closed')
      })
    }

    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()

    // Deep link handling (#demo-notes, #demo-styles, etc.)
    const hash = window.location.hash
    if (hash.startsWith('#demo-')) {
      const rawWanted = hash.slice(6)
      const wanted = rawWanted === 'styles' ? 'posture' : rawWanted
      const index = labels.indexOf(wanted)
      if (index >= 0) {
        const settle = (): void => scrollToScene(wanted, 'auto')
        settle()
        window.setTimeout(settle, 60)
        window.setTimeout(settle, 300)
        window.setTimeout(settle, 900)
      }
    }

    // Click handlers for dock tiles, top scene pills, and internal notch nav tabs
    tiles.forEach((tile) => {
      tile.addEventListener('click', () => {
        scrollToScene(tile.dataset.demoTile ?? 'closed')
      })
    })

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        scrollToScene(pill.dataset.demoPill ?? 'closed')
      })
    })

    for (const trigger of root.querySelectorAll<HTMLElement>('[data-jump-scene], [data-open-notch]')) {
      trigger.addEventListener('click', () => {
        const target = trigger.dataset.jumpScene ?? trigger.dataset.openNotch ?? 'home'
        scrollToScene(target)
      })
    }
  }
</script>
