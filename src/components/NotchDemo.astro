  }

  .desk-md-checks code {
    padding: 1px 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
  }

  /* ==========================================================================
     4. OS CHROME SWITCHING (macOS Menu Bar + Dock vs Windows 11 Studio)
     ========================================================================== */
  .demo-device[data-os="mac"] .demo-win-only {
    display: none !important;
  }

  .demo-device[data-os="win"] .demo-mac-only {
    display: none !important;
  }

  .demo-top {
    justify-content: space-between;
    height: 32px !important;
    padding-inline: 16px !important;
    background: rgba(5, 5, 7, 0.68) !important;
    backdrop-filter: blur(10px);
  }

  .demo-top-left,
  .demo-top-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .mac-apple {
    width: 13px;
    height: 13px;
    color: #ffffff;
  }

  .demo-top-left strong {
    color: #ffffff;
    font-weight: 600;
  }

  .win-top-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.72);
  }

  .win-top-muted {
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.36);
  }

  .demo-top-pill {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 2px 8px;
  }

  .demo-status-icons {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.65);
  }

  .demo-status-icons svg {
    width: 13px;
    height: 13px;
  }

  .demo-bat {
    width: 18px;
    height: 9px;
    border-radius: 2.5px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    padding: 1px;
    display: inline-flex;
  }

  .demo-bat i {
    display: block;
    width: 85%;
    height: 100%;
    background: #ffffff;
    border-radius: 1px;
  }

  /* macOS Floating Dock vs Windows 11 Full-Width Taskbar */
  .demo-device[data-os="mac"] .demo-taskbar {
    inset: auto 50% 10px auto !important;
    transform: translateX(50%);
    width: auto;
    height: 46px;
    padding-inline: 10px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(12, 12, 16, 0.78);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.75);
  }

  .demo-device[data-os="win"] .demo-taskbar {
    inset: auto 0 0 !important;
    transform: none;
    width: 100%;
    height: 44px;
    padding-inline: 16px;
    border-radius: 0;
    justify-content: space-between;
    background: rgba(8, 8, 11, 0.88);
  }

  .demo-dock-items {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .demo-win-left,
  .demo-win-tray {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.52);
  }

  .win-start-icon {
    display: grid;
    grid-template-columns: repeat(2, 6px);
    gap: 1.5px;
  }

  .win-start-icon i {
    width: 6px;
    height: 6px;
    background: rgba(255, 255, 255, 0.75);
    border-radius: 1px;
  }

  .win-search-pill {
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.09);
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.42);
  }

  .demo-tile {
    position: relative;
  }

  .tile-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 3px 8px;
    border-radius: 6px;
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #ffffff;
    font-family: var(--mono);
    font-size: 9.5px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 140ms ease;
  }

  .demo-tile:hover .tile-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ==========================================================================
     5. FULL-SCALE NOTCH EXPANSION DIMENSIONS & MORPHING
     ========================================================================== */
  .demo-notch {
    width: 100%;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .island {
    pointer-events: auto;
    width: 248px !important;
    height: 34px !important;
    background: rgba(6, 6, 8, 0.96) !important;
    border: 1px solid rgba(255, 255, 255, 0.16) !important;
    border-top: 0 !important;
    border-radius: 0 0 15px 15px !important;
    backdrop-filter: blur(24px) !important;
    box-shadow:
      0 26px 70px -18px rgba(0, 0, 0, 0.95),
      0 0 0 1px rgba(255, 255, 255, 0.05) !important;
    transition:
      width 480ms cubic-bezier(0.22, 1, 0.36, 1),
      height 480ms cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 480ms cubic-bezier(0.22, 1, 0.36, 1) !important;
  }

  :global([data-scene="home"]) .island,
  :global([data-scene="notes"]) .island,
  :global([data-scene="sessions"]) .island {
    width: min(820px, 94%) !important;
    height: 308px !important;
    border-radius: 0 0 22px 22px !important;
  }

  :global([data-scene="plan"]) .island {
    width: min(800px, 93%) !important;
    height: 288px !important;
    border-radius: 0 0 22px 22px !important;
  }

  :global([data-scene="music"]) .island {
    width: min(760px, 92%) !important;
    height: 274px !important;
    border-radius: 0 0 22px 22px !important;
  }

  :global([data-scene="posture"]) .island {
    width: min(800px, 93%) !important;
    height: 274px !important;
    border-radius: 0 0 22px 22px !important;
  }

  /* ==========================================================================
     6. SCENE 1: COLLAPSED HARDWARE NOTCH BAR
     ========================================================================== */
  .is-closed-bar {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 12px;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--mono);
    font-size: 10px;
    cursor: pointer;
  }

  .closed-left,
  .closed-right {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .is-closed-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
  }

  .closed-timer {
    font-weight: 600;
    color: #ffffff;
  }

  .closed-sep,
  .closed-mode {
    color: rgba(255, 255, 255, 0.52);
  }

  .closed-camera {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #0d0d12;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .is-closed-wave {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }

  .is-closed-wave i {
    width: 1.5px;
    height: 55%;
    background: #ffffff;
    border-radius: 1px;
  }

  .is-closed-wave i:nth-child(2) { height: 100%; }
  .is-closed-wave i:nth-child(3) { height: 75%; }
  .is-closed-wave i:nth-child(4) { height: 40%; }

  .closed-agents {
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.68);
  }

  /* ==========================================================================
     7. SHARED EXPANDED NOTCH HEADER BAR (.notch-chrome)
     ========================================================================== */
  .notch-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 40px;
    padding-inline: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    flex-shrink: 0;
  }

  .notch-brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: #ffffff;
  }

  .brand-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
  }

  .brand-sub {
    color: rgba(255, 255, 255, 0.42);
    font-size: 9.5px;
  }

  .notch-tabs {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 2px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .n-tab {
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.56);
    font-family: var(--mono);
    font-size: 10px;
    padding: 3px 9px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 140ms ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .n-tab:hover {
    color: #ffffff;
  }

  .n-tab.is-on {
    background: #ffffff;
    color: #060608;
    font-weight: 600;
  }

  .n-tab em {
    font-style: normal;
    font-size: 9px;
    padding: 0 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
  }

  .n-tab.is-on em {
    background: rgba(0, 0, 0, 0.16);
  }

  .notch-collapse-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.65);
    font-family: var(--mono);
    font-size: 9.5px;
    cursor: pointer;
  }

  .notch-collapse-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .notch-collapse-btn kbd {
    font-size: 8.5px;
    opacity: 0.7;
  }

  /* ==========================================================================
     8. SCENE 2: PERSONAL DASHBOARD (.home-grid)
     ========================================================================== */
  .home-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 14px 16px;
    min-height: 0;
  }

  .home-card {
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.025);
    padding: 12px 13px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    min-width: 0;
  }

  .hc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.48);
  }

  .hc-pill {
    padding: 1px 6px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.78);
    font-size: 8.8px;
  }

  .hc-timer-body {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .hc-ring-wrap {
    position: relative;
    width: 68px;
    height: 68px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
  }

  .hc-ring {
    width: 68px;
    height: 68px;
    transform: rotate(-90deg);
  }

  .hc-ring circle {
    fill: none;
    stroke-width: 4;
  }

  .hc-ring-bg {
    stroke: rgba(255, 255, 255, 0.12);
  }

  .hc-ring-fg {
    stroke: #ffffff;
    stroke-linecap: round;
    stroke-dasharray: 163.36;
    stroke-dashoffset: 38;
  }

  .hc-ring-text {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--mono);
  }

  .hc-ring-text strong {
    font-size: 13px;
    color: #ffffff;
  }

  .hc-ring-text span {
    font-size: 7.5px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
  }

  .hc-timer-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .hc-task-current {
    font-size: 12px;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hc-task-sub {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.46);
  }

  .hc-btn-row {
    display: flex;
    gap: 5px;
    margin-top: 4px;
  }

  .hc-mini-btn {
    font-family: var(--mono);
    font-size: 9px;
    padding: 3px 7px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.78);
  }

  .hc-mini-btn.is-primary {
    background: #ffffff;
    color: #050507;
    border-color: #ffffff;
    font-weight: 600;
  }

  /* Music card inside Home Dashboard */
  .hc-music-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
    flex: 1;
  }

  .hc-album-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hc-album-art {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.35), transparent 50%),
      linear-gradient(145deg, #2e2e34, #101014);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .hc-vinyl-core {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.7);
    background: #08080a;
  }

  .hc-track-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .hc-track-info strong {
    font-size: 11.5px;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hc-track-info span {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.52);
  }

  .hc-seek-bar {
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }

  .hc-seek-bar span {
    display: block;
    height: 100%;
    background: #ffffff;
  }

  .hc-seek-times {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 8.8px;
    color: rgba(255, 255, 255, 0.44);
    margin-top: 3px;
  }

  .hc-transport-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.75);
  }

  .hc-play-pill {
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-size: 9px;
  }

  .hc-queue-hint {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    text-decoration: underline;
  }

  .hc-tasks-list {
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
    justify-content: center;
  }

  .hc-tasks-list .is-task {
    font-size: 11px;
  }

