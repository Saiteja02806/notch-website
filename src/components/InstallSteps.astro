---
import { ArrowRight, FolderOpen } from '@lucide/astro'
import { pricing, formatPrice } from '@/data/pricing'

const earlyPrice = formatPrice(pricing.earlyBird.price)
const standardPrice = formatPrice(pricing.standard.price)
---

<section class="section install" id="install">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span> Prebook &amp; Setup</span>
      <h2 class="h2">Running with your local notes in 60 seconds.</h2>
      <p class="lede">
        Both MacBook (macOS) and Windows builds are coming soon. Prebook once at Early Bird pricing
        ({earlyPrice}, then {standardPrice} at launch) to lock in your license key for both platforms.
      </p>
    </div>

    <div class="steps">
      <div class="step">
        <span class="num">01 · Prebook License</span>
        <h3>Lock in macOS &amp; Windows</h3>
        <p>
          Prebook the one-time Early Bird license ({earlyPrice}, then {standardPrice} at launch) to
          get your license key sent to your email and unlock both MacBook (macOS) and Windows builds
          when they launch.
        </p>
        <a class="link" href="/pricing">Prebook Early Bird ({earlyPrice}) <ArrowRight size={13} /></a>
      </div>

      <div class="step">
        <span class="num">02 · Launch</span>
        <h3>Drop into the top edge</h3>
        <p>
          Open Hero Notch. It tucks cleanly into the MacBook camera notch or the top center of any
          Windows display — with zero Dock or taskbar clutter.
        </p>
      </div>

      <div class="step">
        <span class="num">03 · Open Notes Vault</span>
        <h3>Connect your Markdown folder</h3>
        <p>
          Hover the top center of your screen (or press <strong>Cmd/Ctrl+Shift+Space</strong>), open
          <strong>Notes</strong>, and pick any local Markdown or Obsidian folder. Live inline editing
          and 750ms auto-save start immediately.
        </p>
        <a class="link" href="/help#notes">
          Notes vault guide <FolderOpen size={13} />
        </a>
      </div>
    </div>
  </div>
</section>
