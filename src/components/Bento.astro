---
import { AppWindow, Layers, Move, QrCode, FileText, SlidersHorizontal } from '@lucide/astro'
import PostureShowcase from '@/components/PostureShowcase.astro'
import { bento } from '@/data/content'

const icons = {
  taskbar: AppWindow,
  palette: Layers,
  move: Move,
  pointer: QrCode,
  file: FileText,
  camera: SlidersHorizontal
}
---

<section class="section" id="details" aria-labelledby="details-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span> Everything Inside</span>
      <h2 class="h2" id="details-title">Built to stay quiet until you need it.</h2>
      <p class="lede">
        On-device posture coaching, plain Markdown on disk, live coding agents, calendar alerts,
        media control and local Wi-Fi transfer — in one license.
      </p>
    </div>

    <PostureShowcase />

    <div class="bento">
      {
        bento.map((item) => {
          const Icon = icons[item.icon]
          return (
            <article>
              <span class="icon"><Icon size={16} stroke-width={1.5} /></span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          )
        })
      }
    </div>
  </div>
</section>
