---
import Wordmark from './Wordmark.astro'
import { nav } from '@/data/site'
import { pricing, formatPrice } from '@/data/pricing'

const earlyPrice = formatPrice(pricing.earlyBird.price)
---

<header class="nav" data-nav-root>
  <div class="wrap">
    {/* Column 1 (Left): Brand & Lowercase OS Menu Links */}
    <div class="nav-left">
      <Wordmark />

      <nav class="nav-links" aria-label="Primary">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>

    {/* Column 2 (Center): Live Interactive Top-Edge Hero Notch Trigger + Quick Peek Drawer */}
    <div class="nav-center">
      <button
        type="button"
        class="nav-notch-pill"
        aria-expanded="false"
        aria-controls="nav-notch-peek"
        aria-label="Open Hero Notch quick preview"
        data-nav-notch-btn
      >
        <span class="nav-notch-dot" aria-hidden="true"></span>
        <span class="nav-notch-label">Hero Notch</span>
        <span class="nav-notch-wave" aria-hidden="true" data-nav-wave>
          <i></i><i></i><i></i><i></i>
        </span>
      </button>

      <div
        id="nav-notch-peek"
        class="nav-peek"
        role="dialog"
        aria-label="Hero Notch top-edge quick preview"
        hidden
        data-nav-notch-peek
      >
        <div class="nav-peek-head">
          <span class="nav-peek-kicker">
            <i aria-hidden="true"></i>
            HERO NOTCH · LIVE TOP STRIP
          </span>
          <span class="nav-peek-shortcut" data-nav-peek-kbd>⌘ ⇧ Space</span>
        </div>

        <div class="nav-peek-grid">
          <div class="nav-peek-tile">
            <span class="nav-peek-sub">NOW PLAYING · SMTC</span>
            <strong>Starboy — The Weeknd</strong>
            <div class="nav-peek-row">
              <button
                type="button"
                class="nav-peek-mini-btn"
                data-nav-music-toggle
                aria-pressed="true"
              >
                ❚❚ Playing
              </button>
              <span class="nav-peek-mono">Focus 25:00</span>
            </div>
          </div>

          <div class="nav-peek-tile">
            <span class="nav-peek-sub">OBSIDIAN VAULT · PLATFORM</span>
            <strong>roadmap.md · 750ms save</strong>
            <div class="nav-peek-row">
              <button type="button" class="nav-peek-mini-btn is-active" data-nav-os="mac">
                <svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" aria-hidden="true">
                  <path d="M11.182 8.51c-.015-1.57 1.283-2.327 1.341-2.363-.73-1.068-1.867-1.214-2.271-1.231-.967-.098-1.887.569-2.378.569-.49 0-1.248-.555-2.05-.54-1.055.015-2.027.613-2.57 1.556-1.096 1.9-.28 4.715.788 6.257.522.755 1.144 1.604 1.96 1.574.787-.031 1.084-.509 2.035-.509.951 0 1.218.509 2.05.493.847-.015 1.383-.77 1.903-1.525.6-.876.847-1.724.862-1.769-.019-.008-1.655-.635-1.67-2.512zm-1.564-4.62c.433-.525.725-1.254.645-1.98-.624.025-1.379.416-1.827.94-.401.464-.752 1.207-.658 1.92.697.054 1.407-.355 1.84-.88z" />
                </svg>
                <span>macOS</span>
              </button>
              <button type="button" class="nav-peek-mini-btn" data-nav-os="win">
                <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
                  <path d="M1.5 1.5h5.8v5.8H1.5V1.5zm7.2 0h5.8v5.8H8.7V1.5zM1.5 8.7h5.8v5.8H1.5V8.7zm7.2 0h5.8v5.8H8.7V8.7z" />
                </svg>
                <span>Windows</span>
              </button>
            </div>
          </div>
        </div>

        <div class="nav-peek-foot">
          <div class="nav-peek-links">
            <a href="/#setup-video" data-nav-peek-close>51s Setup Video</a>
            <a href="/#details" data-nav-peek-close>Capabilities ↓</a>
          </div>
          <a class="btn btn--coral btn--sm" href="/pricing">
            Prebook {earlyPrice}
          </a>
        </div>
      </div>
    </div>

    {/* Column 3 (Right): OS Telemetry Tray + Primary Purchase Pill + Mobile Menu */}
    <div class="nav-end">
      <div class="nav-os-tray" aria-label="System status">
        <svg viewBox="0 0 16 12" width="13" height="10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
          <path d="M1.5 4.2a9.5 9.5 0 0 1 13 0" />
          <path d="M4 6.8a6 6 0 0 1 8 0" />
          <circle cx="8" cy="10" r="1" fill="currentColor" stroke="none" />
        </svg>
        <span class="nav-os-battery" title="100% charged">
          <svg viewBox="0 0 20 11" width="16" height="9" fill="none" aria-hidden="true">
            <rect x="0.75" y="0.75" width="16.5" height="9.5" rx="2.2" stroke="currentColor" stroke-width="1.2" />
            <rect x="2.5" y="2.5" width="13" height="6" rx="1" fill="currentColor" />
            <path d="M18.5 3.6v3.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span>100%</span>
        </span>
        <span class="nav-os-clock" data-nav-clock>12:00 PM</span>
      </div>

      <a class="btn btn--coral btn--sm nav-cta" href="/pricing">
        <span class="nav-cta-full">Prebook Hero Notch · {earlyPrice}</span>
        <span class="nav-cta-short">Prebook · {earlyPrice}</span>
      </a>

      <details class="nav-mobile">
        <summary aria-label="Open menu">
          <span></span><span></span>
        </summary>
        <div class="nav-mobile-panel">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/pricing" data-loading-link>prebook hero notch · {earlyPrice}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-left {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    min-width: 0;
  }

  .nav-center {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-notch-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 13px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: #020203;
    color: #fafafa;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    cursor: pointer;
    box-shadow:
      0 6px 18px rgba(0, 0, 0, 0.72),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
  }

  .nav-notch-pill:hover,
  .nav-notch-pill[aria-expanded='true'] {
    border-color: rgba(255, 255, 255, 0.48);
    background: #0c0c10;
  }

  .nav-notch-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.85);
    flex-shrink: 0;
  }

  .nav-notch-label {
    white-space: nowrap;
    font-weight: 600;
  }

  .nav-notch-wave {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }

  .nav-notch-wave i {
    width: 1.5px;
    height: 45%;
    border-radius: 1px;
    background: #ffffff;
    animation: navWave 1.1s ease-in-out infinite;
  }

  .nav-notch-wave i:nth-child(2) {
    height: 95%;
    animation-delay: 0.14s;
  }

  .nav-notch-wave i:nth-child(3) {
    height: 65%;
    animation-delay: 0.28s;
  }

  .nav-notch-wave i:nth-child(4) {
    height: 85%;
    animation-delay: 0.42s;
  }

  .nav-notch-wave.is-paused i {
    animation-play-state: paused;
    transform: scaleY(0.35);
  }

  @keyframes navWave {
    0%,
    100% {
      transform: scaleY(0.45);
    }
    50% {
      transform: scaleY(1);
    }
  }

  /* Center Quick Peek Dropdown */
  .nav-peek {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    width: min(440px, 92vw);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(8, 8, 11, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow:
      0 26px 64px -14px rgba(0, 0, 0, 0.92),
      0 0 0 1px rgba(255, 255, 255, 0.06) inset;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 80;
  }

  .nav-peek[hidden] {
    display: none;
  }

  .nav-peek-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.65);
  }

  .nav-peek-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    font-weight: 600;
  }

  .nav-peek-kicker i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ffffff;
  }

  .nav-peek-shortcut {
    padding: 2px 7px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.8);
  }

  .nav-peek-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .nav-peek-tile {
    padding: 10px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .nav-peek-sub {
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.09em;
    color: rgba(255, 255, 255, 0.45);
  }

  .nav-peek-tile strong {
    font-size: 12px;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-peek-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-top: 2px;
  }

  .nav-peek-mini-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--mono);
    font-size: 9.5px;
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
  }

  .nav-peek-mini-btn.is-active,
  .nav-peek-mini-btn:hover {
    background: #ffffff;
    color: #050507;
    border-color: #ffffff;
  }

  .nav-peek-mono {
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.56);
  }

  .nav-peek-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nav-peek-links {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: 10px;
  }

  .nav-peek-links a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
  }

  .nav-peek-links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Right System Telemetry Tray */
  .nav-os-tray {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: rgba(250, 250, 250, 0.65);
    padding-right: 4px;
    white-space: nowrap;
  }

  .nav-os-battery {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .nav-os-clock {
    color: rgba(250, 250, 250, 0.85);
    font-variant-numeric: tabular-nums;
  }

  .nav-cta {
    white-space: nowrap;
  }

  .nav-cta-short {
    display: none;
  }

  @media (max-width: 1120px) {
    .nav-os-tray {
      display: none;
    }
  }

  @media (max-width: 959px) {
    .nav-notch-pill {
      padding: 0 10px;
      height: 28px;
    }

    .nav-cta-full {
      display: none;
    }

    .nav-cta-short {
      display: inline;
    }
  }

  @media (max-width: 639px) {
    .nav-center {
      display: none;
    }

    .nav-cta {
      padding: 8px 13px;
      font-size: 12.5px;
    }
  }

  @media (max-width: 480px) {
    .nav-notch-label {
      display: none;
    }

    .nav-peek-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const navRoot = document.querySelector<HTMLElement>('[data-nav-root]')
  if (navRoot) {
    const syncScroll = (): void => {
      navRoot.classList.toggle('is-stuck', window.scrollY > 6)
    }
    syncScroll()
    window.addEventListener('scroll', syncScroll, { passive: true })

    // Live OS clock in menu bar
    const clockEl = navRoot.querySelector<HTMLElement>('[data-nav-clock]')
    const updateClock = (): void => {
      if (!clockEl) return
      const now = new Date()
      clockEl.textContent = now.toLocaleTimeString('en-US', {
        hour: 'numeric',
        minute: '2-digit'
      })
    }
    updateClock()
    window.setInterval(updateClock, 30000)

    // Center Hero Notch Quick Peek Drawer
    const notchBtn = navRoot.querySelector<HTMLButtonElement>('[data-nav-notch-btn]')
    const peekDrawer = navRoot.querySelector<HTMLElement>('[data-nav-notch-peek]')
    const musicBtn = navRoot.querySelector<HTMLButtonElement>('[data-nav-music-toggle]')
    const waveEl = navRoot.querySelector<HTMLElement>('[data-nav-wave]')
    const kbdEl = navRoot.querySelector<HTMLElement>('[data-nav-peek-kbd]')
    const osBtns = Array.from(navRoot.querySelectorAll<HTMLButtonElement>('[data-nav-os]'))

    const setPeekOpen = (open: boolean): void => {
      if (!notchBtn || !peekDrawer) return
      notchBtn.setAttribute('aria-expanded', String(open))
      peekDrawer.hidden = !open
    }

    notchBtn?.addEventListener('click', (e) => {
      e.stopPropagation()
      const currentlyOpen = notchBtn.getAttribute('aria-expanded') === 'true'
      setPeekOpen(!currentlyOpen)
    })

    peekDrawer?.querySelectorAll('[data-nav-peek-close]').forEach((el) => {
      el.addEventListener('click', () => setPeekOpen(false))
    })

    document.addEventListener('click', (e) => {
      if (!peekDrawer || peekDrawer.hidden) return
      const target = e.target as Node
      if (!peekDrawer.contains(target) && !notchBtn?.contains(target)) {
        setPeekOpen(false)
      }
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setPeekOpen(false)
    })

    // Close mobile <details> menu when tapping any nav link, clicking outside, or pressing Escape
    const mobileMenu = navRoot.querySelector<HTMLDetailsElement>('.nav-mobile')
    if (mobileMenu) {
      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.open = false
        })
      })
      document.addEventListener('click', (e) => {
        if (!mobileMenu.open) return
        if (!mobileMenu.contains(e.target as Node)) {
          mobileMenu.open = false
        }
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu.open) mobileMenu.open = false
      })
    }

    let playing = true
    musicBtn?.addEventListener('click', () => {
      playing = !playing
      musicBtn.textContent = playing ? '❚❚ Playing' : '▶ Paused'
      musicBtn.setAttribute('aria-pressed', String(playing))
      waveEl?.classList.toggle('is-paused', !playing)
    })

    osBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const os = btn.dataset.navOs
        osBtns.forEach((b) => b.classList.toggle('is-active', b === btn))
        if (kbdEl) {
          kbdEl.textContent = os === 'win' ? 'Ctrl + Shift + Space' : '⌘ ⇧ Space'
        }
      })
    })
  }
</script>
