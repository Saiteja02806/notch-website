    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 140ms ease, border-color 140ms ease;
  }

  .split-focus-btn:hover {
    background: #ffffff;
    color: #050507;
    border-color: #ffffff;
  }

  .split-os-card__dock {
    padding: 8px 12px;
    display: flex;
    justify-content: center;
    background: rgba(4, 4, 6, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .split-mac-dock,
  .split-win-tb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    font-family: var(--mono);
    font-size: 10px;
    color: #ffffff;
  }

  .split-mac-dock em,
  .split-win-tb em {
    font-style: normal;
    font-size: 9px;
    color: rgba(250, 250, 250, 0.52);
    margin-left: 4px;
  }

  .split-os-card__dock--win {
    justify-content: space-between;
  }

  .split-win-tb {
    width: 100%;
    border-radius: 6px;
    border: 0;
    background: transparent;
  }

  .win-tb-mini {
    background: #ffffff;
    color: #050507;
    padding: 2px 5px;
    border-radius: 4px;
  }

  @media (max-width: 860px) {
    .split-compare-stage,
    .stage[data-os="split"] .split-compare-stage {
      grid-template-columns: 1fr;
    }
  }

  /* ------------------------------------------------ Notch Header */
  .hn-header {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.015);
  }

  .hn-brand {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .hn-brand__glyph {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: #050507;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .hn-brand__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
  }

  .hn-brand__name {
    font-size: 12.5px;
    font-weight: 600;
    color: #ffffff;
  }

  .hn-brand__sep {
    width: 1px;
    height: 11px;
    background: rgba(255, 255, 255, 0.16);
  }

  .hn-brand__greet {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    color: rgba(250, 250, 250, 0.5);
  }

  .hn-nav {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.11);
    background: #040406;
    flex-shrink: 0;
  }

  .hn-nav__btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: rgba(250, 250, 250, 0.6);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 550;
    white-space: nowrap;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }

  .hn-nav__btn:hover {
    color: #ffffff;
  }

  .hn-nav__btn.is-active {
    background: #ffffff;
    color: #050507;
  }

  .hn-nav__badge {
    padding: 0 5px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 9.5px;
    background: rgba(255, 255, 255, 0.16);
    color: inherit;
  }

  .hn-nav__btn.is-active .hn-nav__badge {
    background: #050507;
    color: #ffffff;
  }

  .hn-actions {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .hn-clock {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    color: rgba(250, 250, 250, 0.52);
    margin-right: 2px;
    white-space: nowrap;
  }

  .hn-action-btn {
    padding: 4px 8px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(250, 250, 250, 0.78);
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.03em;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 140ms ease, background 140ms ease, color 140ms ease;
  }

  .hn-action-btn:hover {
    border-color: #ffffff;
    color: #ffffff;
  }

  .hn-action-btn.is-active {
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  /* ------------------------------------------------ Notch Body & 6-Card Grid */
  .hn-body {
    padding: 14px 16px;
  }

  .hn-view {
    display: none;
  }

  .hn-view.is-active {
    display: block;
  }

  .hn-bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .hn-card {
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(16, 16, 20, 0.9);
    padding: 13px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    min-height: 178px;
  }

  /* Card 1: Inverted High-Contrast Monochrome Focus Card */
  .hn-card--focus {
    background: linear-gradient(155deg, #ffffff 0%, #e4e4e7 100%);
    border-color: #ffffff;
    color: #050507;
    box-shadow: 0 14px 34px -12px rgba(255, 255, 255, 0.25);
  }

  .hn-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .hn-card__kicker {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(250, 250, 250, 0.52);
  }

  .hn-card--focus .hn-card__kicker {
    color: rgba(5, 5, 7, 0.65);
  }

  .hn-card__meta {
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(250, 250, 250, 0.55);
  }

  .hn-card__meta--live {
    color: #ffffff;
  }

  /* Focus Card Internals */
  .hn-focus-modes {
    display: inline-flex;
    gap: 3px;
    padding: 2px;
    border-radius: 999px;
    background: rgba(5, 5, 7, 0.1);
  }

  .hn-mode-pill {
    padding: 2px 7px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: rgba(5, 5, 7, 0.7);
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
  }

  .hn-mode-pill.is-active {
    background: #050507;
    color: #ffffff;
  }

  .hn-focus-body {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hn-ring-wrap {
    position: relative;
    width: 86px;
    height: 86px;
    flex: 0 0 auto;
  }

  .hn-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .hn-ring__track {
    fill: none;
    stroke: rgba(5, 5, 7, 0.12);
    stroke-width: 7;
  }

  .hn-ring__bar {
    fill: none;
    stroke: #050507;
    stroke-width: 7;
    stroke-linecap: round;
    transition: stroke-dashoffset 300ms ease;
  }

  .hn-ring__center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hn-ring__sub {
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.12em;
    color: rgba(5, 5, 7, 0.6);
  }

  .hn-ring__time {
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 700;
    color: #050507;
  }

  .hn-focus-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hn-focus-copy {
    margin: 0;
    font-size: 11px;
    line-height: 1.4;
    color: rgba(5, 5, 7, 0.78);
  }

  .hn-focus-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hn-focus-play {
    padding: 6px 12px;
    border-radius: 999px;
    border: 0;
    background: #050507;
    color: #ffffff;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    cursor: pointer;
  }

  .hn-focus-reset {
    padding: 5px 9px;
    border-radius: 999px;
    border: 1px solid rgba(5, 5, 7, 0.25);
    background: transparent;
    color: #050507;
    font-family: var(--mono);
    font-size: 10px;
    cursor: pointer;
  }

  /* Card 2: Now Playing */
  .hn-music-main {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .hn-album-art {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: radial-gradient(circle at 30% 30%, #27272a, #09090b);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .hn-album-art--lg {
    width: 64px;
    height: 64px;
  }

  .hn-vinyl {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hn-vinyl__core {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffffff;
  }

  .hn-music-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .hn-music-title {
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hn-music-artist {
    font-size: 11px;
    color: rgba(250, 250, 250, 0.58);
  }

  .hn-progress-track {
    height: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  .hn-progress-fill {
    height: 100%;
    border-radius: 999px;
    background: #ffffff;
    transition: width 220ms ease;
  }

  .hn-progress-times {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(250, 250, 250, 0.45);
  }

  .hn-music-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .hn-music-next {
    font-size: 10.5px;
    color: rgba(250, 250, 250, 0.5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hn-music-btns {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .hn-icon-btn {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.04);
    color: #ffffff;
    font-size: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .hn-icon-btn--primary {
    background: #ffffff;
    color: #050507;
    border-color: #ffffff;
  }

  /* Card 3: Today Tasks */
  .hn-task-list {
    list-style: none;
    margin: 0;
    padding: 0 2px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: 128px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .hn-task-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 4px 6px;
    border-radius: 6px;
    border: 0;
    background: rgba(255, 255, 255, 0.025);
    color: #fafafa;
    font-size: 11px;
    text-align: left;
    cursor: pointer;
  }

  .hn-task-item:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .hn-check {
    width: 13px;
    height: 13px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    flex: 0 0 auto;
  }

  .hn-task-item.is-done .hn-check {
    background: #ffffff;
    color: #050507;
    border-color: #ffffff;
  }

  .hn-task-item.is-done .hn-task-text {
    text-decoration: line-through;
    color: rgba(250, 250, 250, 0.42);
  }

  .hn-task-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hn-task-time {
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(250, 250, 250, 0.45);
  }

  .hn-task-form {
    display: flex;
    gap: 5px;
  }

  .hn-task-input {
    flex: 1;
    min-width: 0;
    padding: 5px 8px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(0, 0, 0, 0.4);
    color: #ffffff;
    font-size: 11px;
  }

  .hn-task-submit {
    padding: 4px 9px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-family: var(--mono);
    font-size: 10px;
    cursor: pointer;
  }

  /* Card 4: Notes */
  .hn-notes-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .hn-note-row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.025);
    color: #fafafa;
    font-size: 11.5px;
    cursor: pointer;
    text-align: left;
  }

  .hn-note-row:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.06);
  }

  .hn-note-row__name {
    flex: 1;
    font-weight: 550;
  }

  .hn-note-row__dir {
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(250, 250, 250, 0.45);
  }

  .hn-link-btn {
    border: 0;
    background: transparent;
    color: rgba(250, 250, 250, 0.72);
    font-family: var(--mono);
    font-size: 10px;
    padding: 0;
    cursor: pointer;
  }

  .hn-link-btn:hover {
    color: #ffffff;
  }

  /* Card 5: Coding Sessions */
  .hn-agent-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .hn-agent-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(250, 250, 250, 0.5);
  }

  .hn-agent-pill i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
  }

  .hn-agent-pill.is-live {
    border-color: rgba(255, 255, 255, 0.32);
    color: #ffffff;
  }

  .hn-agent-pill.is-live i {
    background: #ffffff;
    box-shadow: 0 0 6px #ffffff;
  }

  .hn-session-rows {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .hn-session-row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
    color: #fafafa;
    text-align: left;
    cursor: pointer;
  }

  .hn-session-row:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .hn-session-row__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    flex: 0 0 auto;
  }

  .hn-session-row__copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .hn-session-row__copy strong {
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hn-session-row__copy span {
    font-size: 10px;
    color: rgba(250, 250, 250, 0.5);
  }

  .hn-session-row__badge {
    font-family: var(--mono);
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Card 6: Calendar */
  .hn-cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    text-align: center;
    font-family: var(--mono);
    font-size: 9.5px;
  }

  .hn-cal-dow {
    color: rgba(250, 250, 250, 0.4);
    font-size: 8.5px;
  }

  .hn-cal-day {
    padding: 3px 0;
    border-radius: 5px;
    color: rgba(250, 250, 250, 0.78);
  }

  .hn-cal-day.is-muted {
    color: rgba(250, 250, 250, 0.22);
  }

  .hn-cal-day.is-today {
    background: #ffffff;
    color: #050507;
    font-weight: 700;
  }

  .hn-cal-day.is-dot {
    text-decoration: underline;
  }

  .hn-next-event {
    width: 100%;
    padding: 6px 8px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    display: flex;
    flex-direction: column;
    text-align: left;
    color: #fafafa;
    cursor: pointer;
  }

  .hn-next-event__tag {
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.08em;
    color: rgba(250, 250, 250, 0.52);
  }

  .hn-next-event__title {
    font-size: 11px;
  }

  /* ------------------------------------------------ Secondary Tab Views */
  .hn-subview-grid {
    display: grid;
    gap: 12px;
    min-height: 220px;
  }

  .hn-subview-grid--notes {
    grid-template-columns: 230px 1fr;
  }

  .hn-subview-grid--two {
    grid-template-columns: 1fr 1fr;
  }

  .hn-notes-sidebar {
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(14, 14, 18, 0.9);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hn-sidebar-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .hn-file-btn {
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    color: #fafafa;
    display: flex;
    flex-direction: column;
    text-align: left;
    cursor: pointer;
  }

  .hn-file-btn.is-active {
    background: #ffffff;
    color: #050507;
    border-color: #ffffff;
  }

  .hn-file-btn strong {
    font-size: 12px;
  }

  .hn-file-btn span {
    font-size: 10px;
    opacity: 0.65;
  }

  .hn-note-editor {
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(14, 14, 18, 0.9);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hn-note-editor__bar {
    display: flex;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12.5px;
    color: #ffffff;
  }

  .hn-note-editor__content h4 {
    margin: 0 0 6px;
    font-size: 14px;
    color: #ffffff;
  }

  .hn-note-editor__content p {
    margin: 0 0 10px;
    font-size: 12px;
    color: rgba(250, 250, 250, 0.7);
  }

  .hn-md-check {
    font-family: var(--mono);
    font-size: 11px;
    padding: 4px 0;
    color: #e4e4e7;
  }

  .hn-music-deck {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hn-music-deck__meta strong {
    display: block;
    font-size: 15px;
    color: #ffffff;
  }

  .hn-music-deck__meta span {
    font-size: 12px;
    color: rgba(250, 250, 250, 0.65);
  }

  .hn-music-deck__meta p {
    margin: 6px 0 0;
    font-size: 11.5px;
    color: rgba(250, 250, 250, 0.5);
  }

  .hn-queue-list,
  .hn-agenda-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hn-queue-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 10px;
