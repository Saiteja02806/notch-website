---
interface Props {
  image?: string
  alt?: string
  caption?: string
}

const {
  caption = 'folds it · click Pin to lock open'
} = Astro.props
---

<div class="stage-shell" data-stage-root>
  <!-- OS Environment Switcher Bar -->
  <div class="stage-os-bar" role="toolbar" aria-label="Switch operating system environment">
    <div class="stage-os-bar__left">
      <span class="stage-os-bar__label">LIVE INTERACTIVE STAGE</span>
      <span class="stage-os-bar__sep" aria-hidden="true">·</span>
      <span class="stage-os-bar__status" data-stage-status-label>MacBook Pro (macOS Sonoma) · Hardware Notch</span>
    </div>

    <div class="stage-os-switcher" role="tablist" aria-label="Operating System Preview Mode">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        class="stage-os-btn is-active"
        data-os-btn="macos"
      >
        <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true">
          <path d="M11.182 8.51c-.015-1.57 1.283-2.327 1.341-2.363-.73-1.068-1.867-1.214-2.271-1.231-.967-.098-1.887.569-2.378.569-.49 0-1.248-.555-2.05-.54-1.055.015-2.027.613-2.57 1.556-1.096 1.9-.28 4.715.788 6.257.522.755 1.144 1.604 1.96 1.574.787-.031 1.084-.509 2.035-.509.951 0 1.218.509 2.05.493.847-.015 1.383-.77 1.903-1.525.6-.876.847-1.724.862-1.769-.019-.008-1.655-.635-1.67-2.512zm-1.564-4.62c.433-.525.725-1.254.645-1.98-.624.025-1.379.416-1.827.94-.401.464-.752 1.207-.658 1.92.697.054 1.407-.355 1.84-.88z" />
        </svg>
        <span>MacBook (macOS)</span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        class="stage-os-btn"
        data-os-btn="windows"
      >
        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
          <path d="M1.5 1.5h5.8v5.8H1.5V1.5zm7.2 0h5.8v5.8H8.7V1.5zM1.5 8.7h5.8v5.8H1.5V8.7zm7.2 0h5.8v5.8H8.7V8.7z" />
        </svg>
        <span>Windows 11 Studio</span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        class="stage-os-btn"
        data-os-btn="split"
      >
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="1.5" y="2.5" width="13" height="11" rx="2" />
          <line x1="8" y1="2.5" x2="8" y2="13.5" />
        </svg>
        <span>Side-by-Side (Mac + Win)</span>
      </button>
    </div>

    <div class="stage-os-bar__right">
      <button type="button" class="stage-state-toggle" data-toggle-notch-btn>
        <span class="dot"></span>
        <span data-toggle-notch-label>Fold to Top Notch</span>
      </button>
    </div>
  </div>

  <!-- Main OS Monitor Frame -->
  <figure class="stage is-open is-blurred" data-stage data-os="macos" aria-label="Interactive Hero Notch Desktop Simulator">
    <!-- Underlying OS Desktop Wallpaper + Open Code/Markdown Windows -->
    <div class="stage-bg">
      <div class="os-desktop-canvas" aria-hidden="true">
        <!-- Left Background Window: Code Editor / Terminal -->
        <div class="os-win os-win--code">
          <div class="os-win__bar">
            <div class="os-win__dots">
              <i></i><i></i><i></i>
            </div>
            <span class="os-win__title" data-os-win-title>hero-notch — src/main/overlayWindow.ts</span>
            <span class="os-win__tag">TS · UTF-8</span>
          </div>
          <div class="os-win__body">
            <div class="code-line"><span class="ln">01</span><span class="kw">export function</span> <span class="fn">mountTopEdgeOverlay</span>(display: Display) &#123;</div>
            <div class="code-line"><span class="ln">02</span>  <span class="cm">// Zero taskbar icon, zero Dock clutter, 0ms hover wake</span></div>
            <div class="code-line"><span class="ln">03</span>  <span class="kw">const</span> bounds = computeNotchGeometry(display.workArea)</div>
            <div class="code-line"><span class="ln">04</span>  win.setAlwaysOnTop(<span class="kw">true</span>, <span class="st">'screen-saver'</span>)</div>
            <div class="code-line"><span class="ln">05</span>  win.setVisibleOnAllWorkspaces(<span class="kw">true</span>)</div>
            <div class="code-line"><span class="ln">06</span>  <span class="kw">return</span> attachLocalVaultAndAgents(win, bounds)</div>
            <div class="code-line"><span class="ln">07</span>&#125;</div>
          </div>
        </div>

        <!-- Right Background Window: Local Terminal & Obsidian Vault -->
        <div class="os-win os-win--term">
          <div class="os-win__bar">
            <div class="os-win__dots">
              <i></i><i></i><i></i>
            </div>
            <span class="os-win__title">claude-code — ~/obsidian-vault</span>
            <span class="os-win__tag">LOCAL</span>
          </div>
          <div class="os-win__body">
            <div class="code-line"><span class="kw">$</span> claude <span class="st">"Verify Hero Notch macOS &amp; Windows build"</span></div>
            <div class="code-line"><span class="cm">● Streaming session telemetry to Hero Notch top bar...</span></div>
            <div class="code-line"><span class="fn">✓</span> macOS hardware notch anchor: <span class="st">ACTIVE</span></div>
            <div class="code-line"><span class="fn">✓</span> Windows 11 top-edge overlay: <span class="st">ACTIVE</span></div>
            <div class="code-line"><span class="fn">✓</span> Local Obsidian vault: <span class="st">3 notes synced</span></div>
          </div>
        </div>
      </div>

      <!-- Focus Mode Dimming & Backdrop Blur Layer -->
      <div class="stage-focus-veil" aria-hidden="true"></div>
    </div>

    <!-- TOP OS SYSTEM BAR (Adapts to macOS Menu Bar, Windows 11 Studio Bezel, or Split Compare) -->
    <!-- 1. macOS Menu Bar -->
    <div class="os-topbar os-topbar--macos" aria-hidden="true">
      <div class="os-topbar__left">
        <span class="apple-glyph"></span>
        <strong>Finder</strong>
        <span>File</span>
        <span>Edit</span>
        <span>View</span>
        <span>Go</span>
        <span>Window</span>
        <span>Help</span>
      </div>
      <div class="os-topbar__right">
        <span class="os-pill-badge">MacBook Pro · Notch Locked</span>
        <span>Wi-Fi</span>
        <span>98%  battery</span>
        <span>Tue Nov 17 &nbsp;6:18 PM</span>
      </div>
    </div>

    <!-- 2. Windows 11 Top Edge Bezel -->
    <div class="os-topbar os-topbar--windows" aria-hidden="true">
      <div class="os-topbar__left">
        <span class="win-glyph">⊞</span>
        <strong>Windows 11 Studio Desktop</strong>
        <span class="os-pill-badge">Always-on-top Overlay · SkipTaskbar</span>
      </div>
      <div class="os-topbar__right">
        <span>Ctrl + Shift + Space</span>
        <span>Top-Edge Anchor · 0 ms wake</span>
      </div>
    </div>

    <!-- 3. Split Side-by-Side Comparison Top Header -->
    <div class="os-topbar os-topbar--split" aria-hidden="true">
      <div class="os-topbar__left">
        <span class="apple-glyph"></span>
        <strong>macOS Sonoma / Sequoia</strong>
        <span class="os-pill-badge">Sits inside MacBook Notch</span>
      </div>
      <div class="os-topbar__right">
        <span class="os-pill-badge">Snaps to Top Screen Edge</span>
        <strong>Windows 10 / 11</strong>
        <span class="win-glyph">⊞</span>
      </div>
    </div>

    <!-- ================================================================
         THE HERO NOTCH (Collapsed Hardware Pill + Expanded Full App)
         ================================================================ -->
    <div class="stage-notch">
      <!-- Collapsed Hardware Notch Strip (Always anchored at top center) -->
      <button
        class="stage-tab"
        type="button"
        aria-expanded="true"
        aria-controls="stage-panel"
        aria-label="Toggle Hero Notch workspace"
        data-notch-tab
      >
        <span class="stage-tab__dot"></span>
        <span class="stage-tab__timer" data-collapsed-timer>25:00</span>
        <span class="stage-tab__divider" aria-hidden="true"></span>
        <span class="stage-tab__track" data-collapsed-track>Starboy</span>
        <span class="wave" aria-hidden="true" data-collapsed-wave>
          <i></i><i></i><i></i><i></i>
        </span>
      </button>

      <!-- Expanded Code-Built Hero Notch Application Panel -->
      <div class="stage-panel" id="stage-panel" role="region" aria-label="Hero Notch Expanded Workspace">
        <!-- Notch Topbar (Header.tsx replica) -->
        <header class="hn-header">
          <div class="hn-brand">
            <span class="hn-brand__glyph" aria-hidden="true">
              <span class="hn-brand__dot"></span>
            </span>
            <span class="hn-brand__name">Hero Notch</span>
            <span class="hn-brand__sep" aria-hidden="true"></span>
            <span class="hn-brand__greet">GOOD EVENING, SAITEJA</span>
          </div>

          <nav class="hn-nav" role="tablist" aria-label="Hero Notch sections">
            <button type="button" role="tab" aria-selected="true" class="hn-nav__btn is-active" data-hn-tab="home">
              <span>Home</span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="hn-nav__btn" data-hn-tab="notes">
              <span>Notes</span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="hn-nav__btn" data-hn-tab="music">
              <span>Music</span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="hn-nav__btn" data-hn-tab="plan">
              <span>Plan</span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="hn-nav__btn" data-hn-tab="sessions">
              <span>Sessions</span>
              <span class="hn-nav__badge">2</span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="hn-nav__btn" data-hn-tab="posture">
              <span>Posture</span>
            </button>
          </nav>

          <div class="hn-actions">
            <span class="hn-clock">NOV 17 · 6:18 PM</span>
            <button
              type="button"
              class="hn-action-btn is-active"
              data-blur-toggle
              title="Toggle desktop focus blur behind the notch"
            >
              Blur: ON
            </button>
            <button
              type="button"
              class="hn-action-btn is-active"
              data-pin-toggle
              title="Pin Hero Notch open"
            >
              Pinned
            </button>
            <button
              type="button"
              class="hn-action-btn hn-action-btn--collapse"
              data-collapse-btn
              title="Collapse back into top notch (Esc)"
            >
              ^ Collapse
            </button>
          </div>
        </header>

        <!-- Notch Main Workspace Body -->
        <div class="hn-body">
          <!-- ============================================================
               VIEW 1: HOME (6-Card Bento Grid — exact match to real app)
               ============================================================ -->
          <div class="hn-view is-active" data-hn-view="home">
            <div class="hn-bento">
              <!-- Card 1: FOCUS TIMER (High-contrast inverted monochrome card) -->
              <article class="hn-card hn-card--focus">
                <header class="hn-card__head">
                  <span class="hn-card__kicker">FOCUS TIMER</span>
                  <div class="hn-focus-modes" role="group" aria-label="Timer duration">
                    <button type="button" class="hn-mode-pill is-active" data-timer-mode="25" data-timer-label="FOCUS">Focus</button>
                    <button type="button" class="hn-mode-pill" data-timer-mode="5" data-timer-label="SHORT">Short</button>
                    <button type="button" class="hn-mode-pill" data-timer-mode="15" data-timer-label="LONG">Long</button>
                  </div>
                </header>

                <div class="hn-focus-body">
                  <div class="hn-ring-wrap">
                    <svg class="hn-ring" viewBox="0 0 100 100" aria-hidden="true">
                      <circle class="hn-ring__track" cx="50" cy="50" r="42" />
                      <circle
                        class="hn-ring__bar"
                        cx="50"
                        cy="50"
                        r="42"
                        stroke-dasharray="263.89"
                        stroke-dashoffset="35"
                        data-timer-ring
                      />
                    </svg>
                    <div class="hn-ring__center">
                      <span class="hn-ring__sub" data-timer-sublabel>FOCUS</span>
                      <strong class="hn-ring__time" data-timer-display>25:00</strong>
                    </div>
                  </div>

                  <div class="hn-focus-meta">
                    <p class="hn-focus-copy" data-timer-status>Ready for deep work. Click Start to run live countdown.</p>
                    <div class="hn-focus-controls">
                      <button type="button" class="hn-focus-play" data-timer-toggle aria-label="Start or pause focus timer">
                        <span data-timer-btn-text>▶ Start</span>
                      </button>
                      <button type="button" class="hn-focus-reset" data-timer-reset>Reset</button>
                    </div>
                  </div>
                </div>
              </article>

              <!-- Card 2: NOW PLAYING (Interactive Media Controller) -->
              <article class="hn-card">
                <header class="hn-card__head">
                  <span class="hn-card__kicker">NOW PLAYING</span>
                  <span class="hn-card__meta" data-music-status-badge>Spotify · Playing</span>
                </header>

                <div class="hn-music-main">
                  <div class="hn-album-art" aria-hidden="true">
                    <div class="hn-vinyl" data-vinyl-disc>
                      <span class="hn-vinyl__core"></span>
                    </div>
                  </div>
                  <div class="hn-music-info">
                    <strong class="hn-music-title" data-music-title>Starboy (Midnight Synth)</strong>
                    <span class="hn-music-artist" data-music-artist>The Weeknd, Daft Punk</span>
                  </div>
                </div>

                <div class="hn-music-progress">
                  <div class="hn-progress-track">
                    <div class="hn-progress-fill" data-music-bar style="width: 78%;"></div>
                  </div>
                  <div class="hn-progress-times">
                    <span data-music-cur>2:44</span>
                    <span data-music-dur>3:30</span>
                  </div>
                </div>

                <div class="hn-music-foot">
                  <span class="hn-music-next" data-music-next>Next: Midnight City — M83</span>
                  <div class="hn-music-btns">
                    <button type="button" class="hn-icon-btn" data-music-prev aria-label="Previous track">⏮</button>
                    <button type="button" class="hn-icon-btn hn-icon-btn--primary" data-music-toggle aria-label="Play or pause music">
                      <span data-music-play-icon>⏸</span>
                    </button>
                    <button type="button" class="hn-icon-btn" data-music-skip aria-label="Next track">⏭</button>
                  </div>
                </div>
              </article>

              <!-- Card 3: TODAY (Interactive Checklist + Quick Input) -->
              <article class="hn-card">
                <header class="hn-card__head">
                  <span class="hn-card__kicker">TODAY</span>
                  <span class="hn-card__meta" data-tasks-counter>2 left today</span>
                </header>

                <ul class="hn-task-list" data-home-task-list>
                  <li>
                    <button type="button" class="hn-task-item is-done" data-task-toggle>
                      <span class="hn-check">✓</span>
                      <span class="hn-task-text">Ship Hero Notch v1.0.22 (Mac &amp; Win)</span>
                      <span class="hn-task-time">09:30</span>
                    </button>
                  </li>
                  <li>
                    <button type="button" class="hn-task-item is-done" data-task-toggle>
                      <span class="hn-check">✓</span>
                      <span class="hn-task-text">Connect local Obsidian vault</span>
                      <span class="hn-task-time">11:00</span>
                    </button>
                  </li>
                  <li>
                    <button type="button" class="hn-task-item" data-task-toggle>
                      <span class="hn-check"></span>
                      <span class="hn-task-text">Review Claude Code session diff</span>
                      <span class="hn-task-time">14:30</span>
                    </button>
                  </li>
                  <li>
                    <button type="button" class="hn-task-item" data-task-toggle>
                      <span class="hn-check"></span>
                      <span class="hn-task-text">Stand up &amp; check posture ring</span>
                      <span class="hn-task-time">16:40</span>
                    </button>
                  </li>
                </ul>

                <form class="hn-task-form" data-task-form>
                  <input
                    type="text"
                    class="hn-task-input"
                    placeholder="+ Add a task for today…"
                    aria-label="Add a task for today"
                    data-task-input
                  />
                  <button type="submit" class="hn-task-submit">Add</button>
                </form>
              </article>

              <!-- Card 4: NOTES (Obsidian Vault Quick Switcher) -->
              <article class="hn-card">
                <header class="hn-card__head">
                  <span class="hn-card__kicker">NOTES</span>
                  <span class="hn-card__meta">obsidian-vault</span>
                </header>

                <div class="hn-notes-list">
                  <button type="button" class="hn-note-row" data-open-note="release">
                    <span class="hn-note-row__icon">📄</span>
                    <span class="hn-note-row__name">Release-Checklist.md</span>
                    <span class="hn-note-row__dir">Root</span>
                  </button>
                  <button type="button" class="hn-note-row" data-open-note="arch">
                    <span class="hn-note-row__icon">📄</span>
                    <span class="hn-note-row__name">Architecture.md</span>
                    <span class="hn-note-row__dir">Specs</span>
                  </button>
                  <button type="button" class="hn-note-row" data-open-note="daily">
                    <span class="hn-note-row__icon">📄</span>
                    <span class="hn-note-row__name">Daily-Plan.md</span>
                    <span class="hn-note-row__dir">Journal</span>
                  </button>
                </div>

                <div class="hn-card__foot-link">
                  <button type="button" class="hn-link-btn" data-jump-tab="notes">
                    Open inline Markdown editor →
                  </button>
                </div>
              </article>

              <!-- Card 5: CODING SESSIONS (Live Local AI Agent Telemetry) -->
              <article class="hn-card">
                <header class="hn-card__head">
                  <span class="hn-card__kicker">CODING SESSIONS</span>
                  <span class="hn-card__meta hn-card__meta--live">2 live right now</span>
                </header>

                <div class="hn-agent-pills">
                  <span class="hn-agent-pill is-live"><i></i>Claude 1</span>
                  <span class="hn-agent-pill is-live"><i></i>Codex 1</span>
                  <span class="hn-agent-pill"><i></i>OpenCode 0</span>
                  <span class="hn-agent-pill"><i></i>Anti Gravity 0</span>
                </div>

                <div class="hn-session-rows">
                  <button type="button" class="hn-session-row" data-jump-tab="sessions">
                    <span class="hn-session-row__dot is-live"></span>
                    <div class="hn-session-row__copy">
                      <strong>Hero Notch macOS &amp; Windows build</strong>
                      <span>Claude Code · Editing DesktopStage.astro</span>
                    </div>
                    <span class="hn-session-row__badge">LIVE</span>
                  </button>
                  <button type="button" class="hn-session-row" data-jump-tab="sessions">
                    <span class="hn-session-row__dot is-live"></span>
                    <div class="hn-session-row__copy">
                      <strong>Obsidian bi-directional file watcher</strong>
                      <span>Codex CLI · 14 tests passing</span>
                    </div>
                    <span class="hn-session-row__badge">2m</span>
                  </button>
                </div>
              </article>

              <!-- Card 6: CALENDAR (Mini Month Grid + Next Up Agenda) -->
              <article class="hn-card">
                <header class="hn-card__head">
                  <span class="hn-card__kicker">CALENDAR</span>
                  <span class="hn-card__meta">November</span>
                </header>

                <div class="hn-cal-grid" aria-label="November Calendar">
                  <span class="hn-cal-dow">M</span><span class="hn-cal-dow">T</span><span class="hn-cal-dow">W</span><span class="hn-cal-dow">T</span><span class="hn-cal-dow">F</span><span class="hn-cal-dow">S</span><span class="hn-cal-dow">S</span>
                  <span class="hn-cal-day is-muted">26</span><span class="hn-cal-day is-muted">27</span><span class="hn-cal-day is-muted">28</span><span class="hn-cal-day is-muted">29</span><span class="hn-cal-day is-muted">30</span><span class="hn-cal-day">1</span><span class="hn-cal-day">2</span>
                  <span class="hn-cal-day">9</span><span class="hn-cal-day">10</span><span class="hn-cal-day">11</span><span class="hn-cal-day">12</span><span class="hn-cal-day">13</span><span class="hn-cal-day">14</span><span class="hn-cal-day">15</span>
                  <span class="hn-cal-day">16</span><span class="hn-cal-day is-today">17</span><span class="hn-cal-day is-dot">18</span><span class="hn-cal-day">19</span><span class="hn-cal-day is-dot">20</span><span class="hn-cal-day">21</span><span class="hn-cal-day">22</span>
                </div>

                <button type="button" class="hn-next-event" data-jump-tab="plan">
                  <span class="hn-next-event__tag">NEXT UP · 16:40</span>
                  <strong class="hn-next-event__title">Architecture &amp; Release Sync</strong>
                </button>
              </article>
            </div>
          </div>

          <!-- ============================================================
               VIEW 2: NOTES (Live Obsidian / Markdown Split Editor)
               ============================================================ -->
          <div class="hn-view" data-hn-view="notes">
            <div class="hn-subview-grid hn-subview-grid--notes">
              <aside class="hn-notes-sidebar">
                <div class="hn-sidebar-head">
                  <span class="hn-card__kicker">VAULT · OBSIDIAN-VAULT</span>
                  <span class="hn-card__meta">3 .md files</span>
                </div>
                <button type="button" class="hn-file-btn is-active" data-note-select="release">
                  <strong>Release-Checklist.md</strong>
                  <span>Root · Updated just now</span>
                </button>
                <button type="button" class="hn-file-btn" data-note-select="arch">
                  <strong>Architecture.md</strong>
                  <span>Specs · Zero-cloud IPC</span>
                </button>
                <button type="button" class="hn-file-btn" data-note-select="daily">
                  <strong>Daily-Plan.md</strong>
                  <span>Journal · Nov 17</span>
                </button>
              </aside>

              <div class="hn-note-editor">
                <div class="hn-note-editor__bar">
                  <strong data-note-active-title>Release-Checklist.md</strong>
                  <span class="hn-card__meta">Saved directly to ~/obsidian-vault · Plain .md</span>
                </div>
                <div class="hn-note-editor__content" data-note-active-body>
                  <h4># Hero Notch v1.0.22 Release Checklist</h4>
                  <p>All notes edit real local Markdown files on disk — compatible with Obsidian, Cursor, and Git.</p>
                  <div class="hn-md-check">✓ Sign &amp; notarize macOS universal DMG (Apple Silicon + Intel)</div>
                  <div class="hn-md-check">✓ Package Windows 10/11 NSIS installer with top-edge overlay anchor</div>
                  <div class="hn-md-check">✓ Verify Claude Code, Codex, OpenCode &amp; Anti Gravity live hooks</div>
                </div>
              </div>
            </div>
          </div>

          <!-- ============================================================
               VIEW 3: MUSIC (Full Now Playing Deck + Interactive Queue)
               ============================================================ -->
          <div class="hn-view" data-hn-view="music">
            <div class="hn-subview-grid hn-subview-grid--two">
              <div class="hn-card">
                <div class="hn-card__head">
                  <span class="hn-card__kicker">SYSTEM MEDIA SESSION · NOW PLAYING</span>
                  <span class="hn-card__meta">Spotify / Apple Music / YouTube</span>
                </div>
                <div class="hn-music-deck">
