<script>
  const root = document.querySelector<HTMLElement>('[data-stage-root]')
  const stage = root?.querySelector<HTMLElement>('[data-stage]')
  const tab = root?.querySelector<HTMLButtonElement>('[data-notch-tab]')
  const toggleNotchBtn = root?.querySelector<HTMLButtonElement>('[data-toggle-notch-btn]')
  const toggleNotchLabel = root?.querySelector<HTMLElement>('[data-toggle-notch-label]')
  const collapseBtn = root?.querySelector<HTMLButtonElement>('[data-collapse-btn]')
  const pinToggleBtn = root?.querySelector<HTMLButtonElement>('[data-pin-toggle]')
  const blurToggleBtn = root?.querySelector<HTMLButtonElement>('[data-blur-toggle]')

  if (root && stage && tab) {
    let isOpen = true
    let isPinned = true
    let isBlurred = true

    const syncOpenState = (open: boolean): void => {
      isOpen = open
      stage.classList.toggle('is-open', open)
      tab.setAttribute('aria-expanded', String(open))
      if (toggleNotchLabel) {
        toggleNotchLabel.textContent = open ? 'Fold to Top Notch' : 'Unfold Hero Notch'
      }
    }

    const syncPinState = (pinned: boolean): void => {
      isPinned = pinned
      if (pinToggleBtn) {
        pinToggleBtn.classList.toggle('is-active', pinned)
        pinToggleBtn.textContent = pinned ? 'Pinned' : 'Pin'
      }
    }

    const syncBlurState = (blurred: boolean): void => {
      isBlurred = blurred
      stage.classList.toggle('is-blurred', blurred)
      if (blurToggleBtn) {
        blurToggleBtn.classList.toggle('is-active', blurred)
        blurToggleBtn.textContent = blurred ? 'Blur: ON' : 'Blur: OFF'
      }
    }

    // 1. Collapse / Expand Controls
    tab.addEventListener('click', () => {
      syncOpenState(!isOpen)
    })

    tab.addEventListener('mouseenter', () => {
      if (!isOpen) syncOpenState(true)
    })

    stage.addEventListener('mouseleave', () => {
      if (!isPinned && isOpen) syncOpenState(false)
    })

    toggleNotchBtn?.addEventListener('click', () => {
      syncOpenState(!isOpen)
    })

    collapseBtn?.addEventListener('click', () => {
      syncOpenState(false)
    })

    pinToggleBtn?.addEventListener('click', () => {
      syncPinState(!isPinned)
    })

    blurToggleBtn?.addEventListener('click', () => {
      syncBlurState(!isBlurred)
    })

    // 2. OS Environment Switcher (MacBook macOS / Windows 11 / Side-by-Side Split)
    const osButtons = root.querySelectorAll<HTMLButtonElement>('[data-os-btn]')
    const statusLabel = root.querySelector<HTMLElement>('[data-stage-status-label]')
    const shortcutBadge = root.querySelector<HTMLElement>('[data-os-shortcut]')
    const shortcutCaption = root.querySelector<HTMLElement>('[data-os-shortcut-caption]')

    const osDescriptions: Record<string, { label: string; key: string; captionKey: string }> = {
      macos: {
        label: 'MacBook Pro (macOS Sonoma) · Hardware Notch',
        key: '⌘ ⇧ Space',
        captionKey: 'Cmd + Shift + Space'
      },
      windows: {
        label: 'Windows 11 Studio · Top-Edge Overlay (Zero Taskbar Icon)',
        key: 'Ctrl + Shift + Space',
        captionKey: 'Ctrl + Shift + Space'
      },
      split: {
        label: 'MacBook (macOS) + Windows 11 · Dual OS Architecture Compare',
        key: '⌘ / Ctrl + ⇧ + Space',
        captionKey: 'Cmd/Ctrl + Shift + Space'
      }
    }

    const activateOsMode = (mode: string): void => {
      stage.setAttribute('data-os', mode)
      osButtons.forEach((b) => {
        const active = b.dataset.osBtn === mode
        b.classList.toggle('is-active', active)
        b.setAttribute('aria-selected', String(active))
      })
      const info = osDescriptions[mode]
      if (info) {
        if (statusLabel) statusLabel.textContent = info.label
        if (shortcutBadge) shortcutBadge.textContent = info.key
        if (shortcutCaption) shortcutCaption.textContent = info.captionKey
      }
      if (toggleNotchBtn) {
        toggleNotchBtn.style.display = mode === 'split' ? 'none' : ''
      }
    }

    osButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activateOsMode(btn.dataset.osBtn || 'macos')
      })
    })

    root.querySelectorAll<HTMLButtonElement>('[data-switch-os]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.switchOs || 'macos'
        activateOsMode(mode)
      })
    })

    // 3. Section Navigation Tabs (Home, Notes, Music, Plan, Sessions, Posture)
    const navBtns = root.querySelectorAll<HTMLButtonElement>('[data-hn-tab]')
    const views = root.querySelectorAll<HTMLElement>('[data-hn-view]')

    const switchTab = (targetTab: string): void => {
      if (!isOpen) syncOpenState(true)
      navBtns.forEach((btn) => {
        const active = btn.dataset.hnTab === targetTab
        btn.classList.toggle('is-active', active)
        btn.setAttribute('aria-selected', String(active))
      })
      views.forEach((view) => {
        view.classList.toggle('is-active', view.dataset.hnView === targetTab)
      })
    }

    navBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.hnTab) switchTab(btn.dataset.hnTab)
      })
    })

    root.querySelectorAll<HTMLElement>('[data-jump-tab]').forEach((el) => {
      el.addEventListener('click', () => {
        if (el.dataset.jumpTab) switchTab(el.dataset.jumpTab)
      })
    })

    // 4. Interactive Focus Timer (Card 1)
    let totalSeconds = 25 * 60
    let remainingSeconds = 25 * 60
    let timerInterval: number | null = null

    const timerDisplay = root.querySelector<HTMLElement>('[data-timer-display]')
    const collapsedTimer = root.querySelector<HTMLElement>('[data-collapsed-timer]')
    const timerRing = root.querySelector<SVGCircleElement>('[data-timer-ring]')
    const timerToggleBtn = root.querySelector<HTMLButtonElement>('[data-timer-toggle]')
    const timerBtnText = root.querySelector<HTMLElement>('[data-timer-btn-text]')
    const timerResetBtn = root.querySelector<HTMLButtonElement>('[data-timer-reset]')
    const timerStatus = root.querySelector<HTMLElement>('[data-timer-status]')
    const timerSublabel = root.querySelector<HTMLElement>('[data-timer-sublabel]')
    const modePills = root.querySelectorAll<HTMLButtonElement>('[data-timer-mode]')

    const formatMMSS = (secs: number): string => {
      const m = Math.floor(secs / 60)
      const s = secs % 60
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
    }

    const renderTimer = (): void => {
      const formatted = formatMMSS(remainingSeconds)
      if (timerDisplay) timerDisplay.textContent = formatted
      if (collapsedTimer) collapsedTimer.textContent = formatted
      if (timerRing) {
        const circumference = 263.89
        const ratio = totalSeconds > 0 ? remainingSeconds / totalSeconds : 0
        const offset = circumference * (1 - ratio)
        timerRing.style.strokeDashoffset = String(offset.toFixed(2))
      }
    }

    const stopTimer = (): void => {
      if (timerInterval !== null) {
        window.clearInterval(timerInterval)
        timerInterval = null
      }
      if (timerBtnText) timerBtnText.textContent = '▶ Start'
      if (timerStatus) timerStatus.textContent = 'Timer paused. Click Start to resume countdown.'
    }

    timerToggleBtn?.addEventListener('click', () => {
      if (timerInterval !== null) {
        stopTimer()
      } else {
        if (timerBtnText) timerBtnText.textContent = '⏸ Pause'
        if (timerStatus) timerStatus.textContent = 'Deep focus session active — ticking live in top notch.'
        timerInterval = window.setInterval(() => {
          if (remainingSeconds > 0) {
            remainingSeconds -= 1
            renderTimer()
          } else {
            stopTimer()
          }
        }, 1000)
      }
    })

    timerResetBtn?.addEventListener('click', () => {
      stopTimer()
      remainingSeconds = totalSeconds
      renderTimer()
      if (timerStatus) timerStatus.textContent = 'Timer reset. Ready for deep work.'
    })

    modePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        stopTimer()
        const mins = Number(pill.dataset.timerMode || '25')
        totalSeconds = mins * 60
        remainingSeconds = totalSeconds
        modePills.forEach((p) => p.classList.toggle('is-active', p === pill))
        if (timerSublabel && pill.dataset.timerLabel) {
          timerSublabel.textContent = pill.dataset.timerLabel
        }
        renderTimer()
      })
    })

    // 5. Interactive Now Playing Media Deck (Card 2 + Music Tab)
    const tracks = [
      {
        title: 'Starboy (Midnight Synth)',
        short: 'Starboy',
        artist: 'The Weeknd, Daft Punk',
        cur: '2:44',
        dur: '3:30',
        pct: '78%',
        next: 'Next: Midnight City — M83'
      },
      {
        title: 'Midnight City',
        short: 'Midnight City',
        artist: 'M83 · Hurry Up, We’re Dreaming',
        cur: '1:52',
        dur: '4:03',
        pct: '46%',
        next: 'Next: Veridis Quo — Daft Punk'
      },
      {
        title: 'Veridis Quo',
        short: 'Veridis Quo',
        artist: 'Daft Punk · Discovery',
        cur: '3:18',
        dur: '5:45',
        pct: '58%',
        next: 'Next: Starboy — The Weeknd'
      }
    ]
    let currentTrackIdx = 0
    let isPlaying = true

    const renderTrack = (): void => {
      const t = tracks[currentTrackIdx]
      if (!t) return
      const setTxt = (sel: string, val: string) => {
        const el = root.querySelector<HTMLElement>(sel)
        if (el) el.textContent = val
      }
      setTxt('[data-music-title]', t.title)
      setTxt('[data-music-artist]', t.artist)
      setTxt('[data-music-title-2]', t.title)
      setTxt('[data-music-artist-2]', t.artist)
      setTxt('[data-music-cur]', t.cur)
      setTxt('[data-music-dur]', t.dur)
      setTxt('[data-music-next]', t.next)
      setTxt('[data-collapsed-track]', t.short)
      setTxt('[data-music-play-icon]', isPlaying ? '⏸' : '▶')
      setTxt('[data-music-status-badge]', isPlaying ? 'Spotify · Playing' : 'Spotify · Paused')
      setTxt('[data-footer-music]', isPlaying ? `Spotify · ${t.short}` : 'Spotify · Paused')

      const bar = root.querySelector<HTMLElement>('[data-music-bar]')
      if (bar) bar.style.width = t.pct

      const wave = root.querySelector<HTMLElement>('[data-collapsed-wave]')
      wave?.classList.toggle('is-paused', !isPlaying)

      root.querySelectorAll<HTMLElement>('[data-pick-track]').forEach((btn, idx) => {
        btn.classList.toggle('is-active', idx === currentTrackIdx)
      })
    }

    root.querySelector<HTMLButtonElement>('[data-music-toggle]')?.addEventListener('click', () => {
      isPlaying = !isPlaying
      renderTrack()
    })

    root.querySelector<HTMLButtonElement>('[data-music-skip]')?.addEventListener('click', () => {
      currentTrackIdx = (currentTrackIdx + 1) % tracks.length
      isPlaying = true
      renderTrack()
    })

    root.querySelector<HTMLButtonElement>('[data-music-prev]')?.addEventListener('click', () => {
      currentTrackIdx = (currentTrackIdx - 1 + tracks.length) % tracks.length
      isPlaying = true
      renderTrack()
    })

    root.querySelectorAll<HTMLButtonElement>('[data-pick-track]').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentTrackIdx = Number(btn.dataset.pickTrack || '0')
        isPlaying = true
        renderTrack()
      })
    })

    // 6. Interactive Today Tasks (Card 3)
    const taskList = root.querySelector<HTMLElement>('[data-home-task-list]')
    const taskForm = root.querySelector<HTMLFormElement>('[data-task-form]')
    const taskInput = root.querySelector<HTMLInputElement>('[data-task-input]')
    const tasksCounter = root.querySelector<HTMLElement>('[data-tasks-counter]')
    const footerTasks = root.querySelector<HTMLElement>('[data-footer-tasks]')

    const updateTaskCount = (): void => {
      if (!taskList) return
      const all = taskList.querySelectorAll('.hn-task-item')
      const done = taskList.querySelectorAll('.hn-task-item.is-done')
      const left = Math.max(0, all.length - done.length)
      const label = `${left} left today`
      if (tasksCounter) tasksCounter.textContent = label
      if (footerTasks) footerTasks.textContent = label
    }

    const bindTaskToggle = (btn: Element): void => {
      btn.addEventListener('click', () => {
        btn.classList.toggle('is-done')
        const check = btn.querySelector('.hn-check')
        if (check) check.textContent = btn.classList.contains('is-done') ? '✓' : ''
        updateTaskCount()
      })
    }

    root.querySelectorAll('[data-task-toggle]').forEach(bindTaskToggle)

    taskForm?.addEventListener('submit', (e) => {
      e.preventDefault()
      const value = taskInput?.value.trim()
      if (!value || !taskList) return
      const li = document.createElement('li')
      const btn = document.createElement('button')
      btn.type = 'button'
      btn.className = 'hn-task-item'
      btn.setAttribute('data-task-toggle', '')
      btn.innerHTML = `<span class="hn-check"></span><span class="hn-task-text"></span><span class="hn-task-time">NOW</span>`
      const textSpan = btn.querySelector('.hn-task-text')
      if (textSpan) textSpan.textContent = value
      bindTaskToggle(btn)
      li.appendChild(btn)
      taskList.appendChild(li)
      if (taskInput) taskInput.value = ''
      updateTaskCount()
    })

    // 7. Interactive Notes Switcher (Card 4 + Notes Tab)
    const noteDocs: Record<string, { title: string; html: string }> = {
      release: {
        title: 'Release-Checklist.md',
        html: `<h4># Hero Notch v1.0.22 Release Checklist</h4>
               <p>All notes edit real local Markdown files on disk — compatible with Obsidian, Cursor, and Git.</p>
               <div class="hn-md-check">✓ Sign &amp; notarize macOS universal DMG (Apple Silicon + Intel)</div>
               <div class="hn-md-check">✓ Package Windows 10/11 NSIS installer with top-edge overlay anchor</div>
               <div class="hn-md-check">✓ Verify Claude Code, Codex, OpenCode &amp; Anti Gravity live hooks</div>`
      },
      arch: {
        title: 'Architecture.md',
        html: `<h4># Zero-Cloud Local Architecture</h4>
               <p>Hero Notch runs 100% locally. No account signup, no cloud database, and zero background telemetry.</p>
               <div class="hn-md-check">✓ macOS: NSWindow attached below MacBook hardware camera housing</div>
               <div class="hn-md-check">✓ Windows 11: Top-edge frameless overlay with skipTaskbar enabled</div>`
      },
      daily: {
        title: 'Daily-Plan.md',
        html: `<h4># Daily Log — November 17</h4>
               <p>Focused sprint on interactive Hero Stage &amp; side-by-side MacBook / Windows 11 showcase.</p>
               <div class="hn-md-check">✓ Complete 4 × 25m deep focus intervals</div>
               <div class="hn-md-check">✓ Sync Google Calendar ICS feed locally</div>`
      }
    }

    const selectNote = (key: string): void => {
      const doc = noteDocs[key]
      if (!doc) return
      const titleEl = root.querySelector<HTMLElement>('[data-note-active-title]')
      const bodyEl = root.querySelector<HTMLElement>('[data-note-active-body]')
      if (titleEl) titleEl.textContent = doc.title
      if (bodyEl) bodyEl.innerHTML = doc.html
      root.querySelectorAll<HTMLElement>('[data-note-select]').forEach((b) => {
        b.classList.toggle('is-active', b.dataset.noteSelect === key)
      })
    }

    root.querySelectorAll<HTMLElement>('[data-open-note]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.openNote || 'release'
        selectNote(key)
        switchTab('notes')
      })
    })

    root.querySelectorAll<HTMLElement>('[data-note-select]').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectNote(btn.dataset.noteSelect || 'release')
      })
    })

    // 8. Interactive Posture Calibration (Tab 6)
    root.querySelectorAll<HTMLButtonElement>('[data-posture-set]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const score = btn.dataset.postureSet || '92'
        const scoreEl = root.querySelector<HTMLElement>('[data-posture-score]')
        const labelEl = root.querySelector<HTMLElement>('[data-posture-label]')
        if (scoreEl) scoreEl.textContent = score
        if (labelEl) {
          labelEl.textContent =
            score === '92'
              ? 'Aligned · Upright Head & Shoulder Pitch'
              : 'Slouch Detected · Subtle Top-Notch Pulse Active'
        }
        root.querySelectorAll('[data-posture-set]').forEach((b) => b.classList.toggle('is-active', b === btn))
      })
    })

    // 9. Keyboard Shortcuts (Esc folds, 1-6 switches tabs when not typing in input)
    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) return

      if (event.key === 'Escape' && isOpen) {
        syncOpenState(false)
        tab.focus()
      }

      const tabMap: Record<string, string> = {
        '1': 'home',
        '2': 'notes',
        '3': 'music',
        '4': 'plan',
        '5': 'sessions',
        '6': 'posture'
      }
      if (tabMap[event.key] && stage.matches(':hover, :focus-within')) {
        switchTab(tabMap[event.key])
      }
    })
  }
</script>

