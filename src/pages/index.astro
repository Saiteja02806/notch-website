---
import Base from '@/layouts/Base.astro'
import HeroCanvas from '@/components/HeroCanvas.astro'
import SetupVideo from '@/components/SetupVideo.astro'
import TrustStrip from '@/components/TrustStrip.astro'
import Bento from '@/components/Bento.astro'
import InstallSteps from '@/components/InstallSteps.astro'
import Faq from '@/components/Faq.astro'
import FinalCta from '@/components/FinalCta.astro'
import { site } from '@/data/site'
import { release } from '@/data/release'
import { pricing } from '@/data/pricing'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Hero Notch',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS, Windows 10, Windows 11',
  softwareVersion: release.version,
  offers: {
    '@type': 'Offer',
    name: 'Early bird license (macOS & Windows)',
    price: pricing.earlyBird.price,
    priceCurrency: pricing.currency,
    url: `${site.url}/pricing`
  },
  author: { '@type': 'Person', name: site.author },
  screenshot: `${site.url}/media/hero-notch-poster.png`
}
---

<Base
  title="Hero Notch — a macOS & Windows notch for notes, AI sessions and music"
  description={site.description}
  jsonLd={jsonLd}
>
  <HeroCanvas />
  <SetupVideo />
  <TrustStrip />
  <Bento />
  <InstallSteps />
  <Faq />
  <FinalCta />
</Base>
