---
import Base from '@/layouts/Base.astro'
import { site } from '@/data/site'
import { pricing, formatPrice } from '@/data/pricing'
import { ArrowRight } from '@lucide/astro'

const groups = [
  {
    id: 'notes',
    title: 'Notes & Obsidian Vaults',
    items: [
      {
        id: 'vault',
        q: 'Can I point Notch at my existing Obsidian vault or Markdown folder?',
        a: 'Yes. Choose any local folder or Obsidian vault. Notch reads and writes plain .md and .txt files in place with 750ms debounced auto-save, and automatically ignores .obsidian, .trash and .git directories so your vault configuration is never polluted.'
      },
      {
        id: 'markdown-syntax',
        q: 'Which Markdown syntax is supported in the inline editor?',
        a: 'Headings (# and ##), clickable task checkboxes (- [ ] and - [x]), **bold**, _italic_, inline `code`, > blockquotes, and [links](url). You can toggle between Inline Edit and clean rendered Preview at any time, or click Open in Obsidian / Reveal in Explorer.'
      },
      {
        id: 'notes-search',
        q: 'How do I search across my notes or organize folders?',
        a: 'Press Ctrl+K inside the Notes tab to search both filenames and full Markdown content across your vault. You can also create nested folders inline, use Expand All to inspect note counts, and drag-and-drop notes between folders.'
      },
      {
        id: 'canvas',
        q: 'Why can’t I edit an Obsidian .canvas file inline?',
        a: 'Canvas files are listed in the file tree and can be renamed or opened in Obsidian with one click, while Notch’s built-in inline editor focuses on plain .md and .txt files.'
      },
      {
        id: 'sync',
        q: 'Does Notch use a cloud sync server for notes?',
        a: 'No. Your notes never leave your disk. If your vault folder is inside Obsidian Sync, OneDrive, iCloud Drive, Dropbox or a Git repository, that tool syncs Notch’s plain .md edits automatically.'
      }
    ]
  },
  {
    id: 'sessions',
    title: 'AI Coding Sessions',
    items: [
      {
        id: 'supported-agents',
        q: 'Which AI coding agents are supported?',
        a: 'Claude Code, Codex, OpenCode and Anti Gravity. Notch inspects their local session stores on your PC to show live turns, active models, token usage and project directories in one unified board.'
      },
      {
        id: 'session-replies',
        q: 'How do follow-up replies and approval alerts work?',
        a: 'You can send a follow-up prompt directly from a session card in the notch. Notch verifies delivery against the local session store (showing a Delivered badge), auto-watches locked Codex threads until they finish, and surfaces real-time OpenCode approval alerts.'
      }
    ]
  },
  {
    id: 'planner',
    title: 'Planner & Google Calendar',
    items: [
      {
        id: 'google-calendar',
        q: 'How does the Google Calendar agenda integration work?',
        a: 'Connect your Google Calendar from the Plan tab to display a live upcoming agenda strip right alongside your local daily priorities, time blocks and month calendar.'
      },
      {
        id: 'reminder-missing',
        q: 'My reminder did not appear.',
        a: 'Make sure Notch is running, the task has a reminder time (at the exact time or 5/10/30/60 minutes before), is not marked completed, and notifications are enabled in Settings.'
      },
      {
        id: 'reminder-dismiss',
        q: 'Why did the reminder card fold away after 12 seconds?',
        a: 'By design: reminder notices unfold directly beneath the collapsed notch for 12 seconds so you see them mid-flow without losing keyboard focus, then fold away automatically.'
      }
    ]
  },
  {
    id: 'phone-transfer',
    title: 'Phone QR & Workspace Utilities',
    items: [
      {
        id: 'phone-qr',
        q: 'How does two-way Phone QR transfer work without the cloud?',
        a: 'When you open the Phone tab, Notch starts a temporary local HTTP server on your PC’s Wi-Fi IP and renders a QR code. Scan it with your phone on the same Wi-Fi network to send or receive files (up to 16 MB) and clipboard snippets directly over LAN.'
      },
      {
        id: 'multi-monitor',
        q: 'Can I move the notch to another monitor or along the top edge?',
        a: 'Yes. In Settings → Appearance, select any connected monitor, use the live placement map to position the notch anywhere along the top edge, or enable the Focus Blur backdrop and browser-aware auto-hide.'
      }
    ]
  },
  {
    id: 'spotify',
    title: 'Music & Spotify',
    items: [
      {
        id: 'spotify-client-id',
        q: 'Do I need a Spotify developer app?',
        a: 'Not for everyday playback control. Notch reads any active Windows media session (SMTC) out of the box with a native album art helper and iTunes cover fallback. Adding a free PKCE Spotify developer Client ID unlocks the Up Next queue, volume slider, shuffle and repeat.'
      },
      {
        id: 'spotify-idle',
        q: 'Spotify is open but nothing appears.',
        a: 'Press play once in Spotify Desktop or any Windows media player so Windows registers an active SMTC session. If your PKCE credentials are already saved, Notch remembers them automatically.'
      },
      {
        id: 'spotify-queue',
        q: 'The Up Next queue is empty.',
        a: 'Spotify’s Web API only returns a queue when a device is actively playing. Start playback on your PC and refresh the Music tab.'
      }
    ]
  },
  {
    id: 'install',
    title: 'Install & Updates',
    items: [
      {
        id: 'publisher',
        q: 'Windows says “unknown publisher” or macOS asks to confirm. Is that normal?',
        a: 'Yes. Independent builds may prompt standard OS verification on first launch. Compare the SHA-256 checksum included on your license receipt before running.'
      },
      {
        id: 'smart-app-control',
        q: 'How does prebooking work for macOS and Windows?',
        a: 'Both MacBook (macOS) and Windows builds are coming soon. A single $3.99 one-time Early Bird prebook gives you your license key immediately and covers both MacBook and Windows as soon as launch builds release.'
      },
      {
        id: 'update',
        q: 'How do I update Hero Notch?',
        a: `Download the newest installer from the Download page (it always points at the latest release) and run it over your existing install, or email ${site.email} if you get stuck. Your local notes folder and settings are preserved, and you will not need to enter your license key again.`
      },
      {
        id: 'settings-file',
        q: 'Where are my settings stored?',
        a: 'In %APPDATA%\\notch\\notch-state.json. It is plain, human-readable JSON so you can inspect or back it up at any time.'
      }
    ]
  },
  {
    id: 'app',
    title: 'Notch Behaviour',
    items: [
      {
        id: 'hover',
        q: 'It will not open on hover.',
        a: 'Check your hover delay in Settings, or click the collapsed tab to pin it open. Exclusive full-screen games or another always-on-top overlay covering the top pixel can also intercept hover events.'
      },
      {
        id: 'close',
        q: 'How do I close or collapse the panel?',
        a: 'Press Esc, click the collapse arrow at the top right, or click outside the expanded notch.'
      },
      {
        id: 'taskbar',
        q: 'Why is there no taskbar icon or Alt-Tab tile?',
        a: 'By design. Notch runs as a lightweight Windows tool window so it never clutters your taskbar, Alt-Tab switcher or Task View. Use the system tray icon whenever you want to quit.'
      }
    ]
  },
  {
    id: 'posture',
    title: 'Posture & Camera Privacy',
    items: [
      {
        id: 'posture-score',
        q: 'The posture score is stuck or empty.',
        a: 'Enable posture, grant camera permission, and run the calibration setup once so Notch learns your camera angle and chair height. The score pauses automatically if no pose is detected.'
      },
      {
        id: 'posture-empty-chair',
        q: 'Will it chime at an empty chair?',
        a: 'No. Threshold chimes require an active pose in frame, so stepping away from your desk will never trigger false alerts.'
      },
      {
        id: 'posture-privacy',
        q: 'Does it record or upload camera frames?',
        a: 'Never. Posture is off by default. When enabled, webcam frames are scored in RAM and discarded immediately — zero images or video are written to disk or sent over the network.'
      }
    ]
  },
  {
    id: 'privacy',
    title: 'Storage & Uninstall',
    items: [
      {
        id: 'stored',
        q: 'What is stored on disk, and where?',
        a: 'Your Markdown notes stay in the folder or Obsidian vault you choose. Settings, tasks, hydration counts and posture totals live in %APPDATA%\\notch\\notch-state.json; optional Spotify/Google tokens live in local JSON files in %APPDATA%\\notch; logs are written to notch.log.'
      },
      {
        id: 'uninstall',
        q: 'How do I remove everything cleanly?',
        a: 'Uninstall Notch from Settings → Apps, then delete %APPDATA%\\notch if you want to remove local preferences and tokens. Your Markdown notes folder is never touched.'
      }
    ]
  }
]
---

<Base
  title="Hero Notch help — Obsidian notes, AI sessions, Google Calendar, Phone QR & install"
  description="Answers for using Hero Notch on MacBook and Windows with local Markdown and Obsidian vaults, Claude Code & Codex sessions, Google Calendar reminders, local Wi-Fi Phone QR transfer, and Spotify."
>
  <section class="wrap">
    <div class="page-head">
      <span class="eyebrow"><span class="dot"></span> Help &amp; Documentation</span>
      <h1>Answers, without a support queue.</h1>
      <p class="lede">
        Everything you need for local Markdown &amp; Obsidian vaults, Claude Code and Codex sessions,
        Google Calendar reminders, two-way Phone QR transfer, Spotify setup and macOS &amp; Windows installation.
      </p>
      <div class="help-head-links">
        <a class="btn btn--ink btn--sm" href="/pricing">
          Get License · {formatPrice(pricing.earlyBird.price)} <ArrowRight size={13} />
        </a>
        <a class="link" href="#notes">Notes &amp; Obsidian</a>
        <a class="link" href="#sessions">AI Sessions</a>
        <a class="link" href="#planner">Google Calendar</a>
        <a class="link" href="#phone-transfer">Phone QR</a>
      </div>
    </div>

    <div class="help-grid">
      {
        groups.map((group) => (
          <section class="help-group" id={group.id}>
            <h2>{group.title}</h2>
            <div class="faq-list">
              {group.items.map((item) => (
                <details id={item.id}>
                  <summary>
                    {item.q}
                    <span class="sign" aria-hidden="true" />
                  </summary>
                  <div class="answer">{item.a}</div>
                </details>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div class="help-foot">
      <p>Still stuck?</p>
      <div class="btns">
        <a class="btn btn--ink btn--sm" href={`mailto:${site.email}`}>Email {site.email}</a>
        <a class="btn btn--ghost btn--sm" href="/pricing">View License &amp; Pricing</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .help-head-links {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .help-grid {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 48px;
  }

  .help-group {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .help-group h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 26px;
    letter-spacing: -0.01em;
    position: sticky;
    top: 88px;
  }

  .help-group .faq-list {
    max-width: none;
  }

  .help-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 28px 0 72px;
    border-top: 1px solid var(--line);
  }

  .help-foot p {
    font-family: var(--serif);
    font-size: 24px;
  }

  .help-foot .btns {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .help-group {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .help-group h2 {
      position: static;
    }
  }
</style>
