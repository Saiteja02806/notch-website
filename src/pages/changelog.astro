---
import Base from '@/layouts/Base.astro'
import { changelog } from '@/data/changelog'
import { release } from '@/data/release'
import { site } from '@/data/site'

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric'
})

const tagUrl = (version: string): string => `${site.releasesUrl}/tag/v${version}`
---

<Base
  title="Notch changelog"
  description="Every Notch release with highlights, installers and checksums."
>
  <section class="wrap">
    <div class="page-head">
      <span class="eyebrow"><span class="dot"></span> Changelog</span>
      <h1>What changed, and when.</h1>
      <p class="lede">
        Highlights only. Full notes, installers and checksums live on GitHub. Latest version:
        {release.version}.
      </p>
      <p><a class="link" href="/changelog.xml">Subscribe via RSS</a></p>
    </div>

    <div class="log">
      {
        changelog.map((entry, index) => (
          <article class="log-item" id={`v${entry.version}`}>
            <div class="log-meta">
              <span class="v">v{entry.version}</span>
              <span class="d">{dateFormat.format(new Date(entry.date))}</span>
              {index === 0 && <span class="badge-latest">Latest</span>}
            </div>

            <div>
              <h2>{entry.title}</h2>
              <ul>
                {entry.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
              <div class="log-links">
                <a class="link" href={tagUrl(entry.version)} rel="noopener">
                  Full notes
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p style="margin-top:32px">
      <a class="link" href={release.allReleasesUrl} rel="noopener">All releases on GitHub</a>
    </p>
  </section>
</Base>
