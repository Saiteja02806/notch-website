---
import Base from '@/layouts/Base.astro'
---

<Base title="Page not found — Notch" description="This page folded away. Try the tour or download the app." noIndex>
  <section class="wrap">
    <div class="not-found">
      <span class="code">404</span>
      <h1>This page folded away.</h1>
      <p>The link is stale or the page moved. Try the tour, or just download the app.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px">
        <a class="btn btn--coral" href="/download">Download Notch</a>
        <a class="btn btn--ghost" href="/">Back to the top</a>
      </div>
    </div>
  </section>
</Base>
